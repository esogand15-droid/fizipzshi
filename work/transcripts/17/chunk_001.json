 "language": "fa",
 "lang_prob": 1,
 "segments": [
  {
   "start": 1200.0,
   "end": 1231.31,
   "text": "حالاتری چقدر انرژی این لایه هم چقدر اختلاف این دوتا میشه انرژی فوتونی که اینجا همجر که بلازمی فرمایی ساعتش شده بهش میگن کلستری سیک در واقع ریدیشن این در واقع فوتونیه که اونجا تولیز شده خب لامپ پرتو ایکس رو من یکم توضیح بدم که بعدش بدم سراغ ادامه بحثه خب در ادامه میگم سراغ خود لامپ پرتو ایکس حالا اتفاقات رو گفتیم پرتو ایکس در اثر دوتا میکانیست تولی"
  },
  {
   "start": 1231.31,
   "end": 1233.27,
   "text": "یه نو پرتو ایکس ترموزی داریم"
  },
  {
   "start": 1233.27,
   "end": 1236.37,
   "text": "یه نو پرتو ایکس در واقع اختصاصی داریم"
  },
  {
   "start": 1236.37,
   "end": 1238.43,
   "text": "یه توضیح بیشتر در موضوع لامپ بدم"
  },
  {
   "start": 1238.43,
   "end": 1242.35,
   "text": "این موضوعاتی که خدمت شما گفتم بیشتر برای شما جا میدفته"
  },
  {
   "start": 1242.35,
   "end": 1247.55,
   "text": "لامپ پرتو ایکس که پدیده ی تولید پرتو ایکس"
  },
  {
   "start": 1247.55,
   "end": 1249.23,
   "text": "معمولا اونجا ما داریم"
  },
  {
   "start": 1249.23,
   "end": 1253.09,
   "text": "همینجور که در واقع مشاهده میفرماییم"
  },
  {
   "start": 1253.09,
   "end": 1259.01,
   "text": "پرتو ایکس در فرایند تبدیل انرژی اتفاق میدفته"
  },
  {
   "start": 1259.01,
   "end": 1263.87,
   "text": "و این هنگامی که یک جریان الکترون های پر سرعت"
  },
  {
   "start": 1263.87,
   "end": 1269.65,
   "text": "از قسمتی از لامپ پرتوی ایکس که بهش میگن کاتود حرکت میکنن"
  },
  {
   "start": 1269.65,
   "end": 1274.75,
   "text": "میان به سمت دیگر لامپ که بهش میگن آنو اونجا به هدف فرخور میکنن"
  },
  {
   "start": 1274.75,
   "end": 1276.29,
   "text": "و تورید پرتوی ایکس میکنن"
  },
  {
   "start": 1276.29,
   "end": 1280.27,
   "text": "ببینین این لامپ پرتوی ایکس که شما دارین شکلش رو ملازم میفرمین"
  },
  {
   "start": 1280.27,
   "end": 1281.49,
   "text": "این لامپ واقعیشه"
  },
  {
   "start": 1281.49,
   "end": 1287.09,
   "text": "این شکل شماتی که از لامپ هست که شما عزیزان دارین مشاهده میکنن"
  },
  {
   "start": 1287.09,
   "end": 1291.67,
   "text": "این قسمتی که من دارم با موس هم نشون میدم حالت فیلامان داره"
  },
  {
   "start": 1291.67,
   "end": 1297.51,
   "text": "فیلامان چیه رشته هست که توی لامپ های صد قدیم وجود داشت رشته های در مارکیچی"
  },
  {
   "start": 1297.51,
   "end": 1300.93,
   "text": "این فیلامان نقش کاتود رو داره"
  },
  {
   "start": 1300.93,
   "end": 1304.97,
   "text": "جاییه که الکترون برای ما تولید میشه"
  },
  {
   "start": 1304.97,
   "end": 1309.55,
   "text": "این قسمت بهش میگن آنود یا تارگت ما یا به عبارتی هدف ما"
  },
  {
   "start": 1309.55,
   "end": 1313.13,
   "text": "یعنی الکترون هایی که از سمت کاتود تولید میشن"
  },
  {
   "start": 1313.13,
   "end": 1315.27,
   "text": "حرکت می کنن توسط اختلاف"
  },
  {
   "start": 1315.27,
   "end": 1317.05,
   "text": "پتانسیلی که ما بهشون می دیم"
  },
  {
   "start": 1317.05,
   "end": 1318.95,
   "text": "با سرعت نور"
  },
  {
   "start": 1318.95,
   "end": 1320.59,
   "text": "و برخور می کنن به قسمت"
  },
  {
   "start": 1320.59,
   "end": 1322.15,
   "text": "هدف ما"
  },
  {
   "start": 1322.15,
   "end": 1325.31,
   "text": "که طبق این برخور تولید فوتون ایکس می کنن"
  },
  {
   "start": 1325.31,
   "end": 1326.93,
   "text": "حالا فوتون ایک چجوری تولید می شه"
  },
  {
   "start": 1326.93,
   "end": 1328.19,
   "text": "همونسی که قبلا گفتم"
  },
  {
   "start": 1328.19,
   "end": 1329.43,
   "text": "ترموزی و برنشتر"
  },
  {
   "start": 1329.43,
   "end": 1332.73,
   "text": "حالا می هم سراغ"
  },
  {
   "start": 1332.73,
   "end": 1334.79,
   "text": "توضیحاتی که در لامب وجود داره"
  },
  {
   "start": 1334.79,
   "end": 1337.19,
   "text": "و من می رم بعدش ادامه بحثم"
  },
  {
   "start": 1337.19,
   "end": 1339.67,
   "text": "لامب پرتو ایکس"
  },
  {
   "start": 1339.67,
   "end": 1341.55,
   "text": "یه پوشش شیشه"
  },
  {
   "start": 1341.55,
   "end": 1343.03,
   "text": "تویه از حواست"
  },
  {
   "start": 1343.03,
   "end": 1345.41,
   "text": "که داره دوتا الکترود داخلش"
  },
  {
   "start": 1345.41,
   "end": 1347.59,
   "text": "الکترود ها به گونه"
  },
  {
   "start": 1347.59,
   "end": 1349.47,
   "text": "تبایی شده هم که الکترون های"
  },
  {
   "start": 1349.47,
   "end": 1351.27,
   "text": "طوری شده تو قسمت کاتود"
  },
  {
   "start": 1351.27,
   "end": 1353.43,
   "text": "که حالا بهش میگن"
  },
  {
   "start": 1353.43,
   "end": 1355.45,
   "text": "معمولا قسمت رشته منفی"
  },
  {
   "start": 1355.45,
   "end": 1357.41,
   "text": "الان به وسیله یک"
  },
  {
   "start": 1357.41,
   "end": 1359.47,
   "text": "اختلاف فتانسیل بالا"
  },
  {
   "start": 1359.47,
   "end": 1361.07,
   "text": "که ما بهش تعریف میکنیم"
  },
  {
   "start": 1361.07,
   "end": 1362.45,
   "text": "اینقدر کیلوورتاج"
  },
  {
   "start": 1362.45,
   "end": 1365.39,
   "text": "به سمت آنود حرکت میکنه که آنود بهش میگن"
  },
  {
   "start": 1365.39,
   "end": 1367.35,
   "text": "الکترود مصبت"
  },
  {
   "start": 1367.35,
   "end": 1367.91,
   "text": "یا هدم"
  },
  {
   "start": 1367.91,
   "end": 1373.23,
   "text": "الکترود هایی که تو قسمت"
  },
  {
   "start": 1373.23,
   "end": 1374.57,
   "text": "کاتود تولین میشن"
  },
  {
   "start": 1374.57,
   "end": 1377.51,
   "text": "توسط اختلاف فتانسیلی"
  },
  {
   "start": 1377.51,
   "end": 1378.67,
   "text": "که ما بهشون وارد میکنیم"
  },
  {
   "start": 1378.67,
   "end": 1381.07,
   "text": "حرکت میکنن میرن سمت آنود"
  },
  {
   "start": 1381.07,
   "end": 1382.43,
   "text": "که حالا بیشتر توزین میرن"
  },
  {
   "start": 1382.43,
   "end": 1384.45,
   "text": "این شکل شماتیکش بود"
  },
  {
   "start": 1384.45,
   "end": 1386.13,
   "text": "که خدمت شما عرض کردم"
  },
  {
   "start": 1386.13,
   "end": 1389.07,
   "text": "از پوشش شیشه"
  },
  {
   "start": 1389.07,
   "end": 1391.51,
   "text": "اطراف کاتود و آنود استفاده میکنن"
  },
  {
   "start": 1391.51,
   "end": 1392.91,
   "text": "و باید داخل این پوشش"
  },
  {
   "start": 1392.91,
   "end": 1394.53,
   "text": "شیشه تویی از هوا باشه"
  },
  {
   "start": 1394.53,
   "end": 1396.29,
   "text": "هیچ هوای وجود نداشته باشه"
  },
  {
   "start": 1396.29,
   "end": 1398.89,
   "text": "چرا؟ اگر کمی هوا هم"
  },
  {
   "start": 1398.89,
   "end": 1399.95,
   "text": "وجود داشته باشه"
  },
  {
   "start": 1399.95,
   "end": 1403.17,
   "text": "الکترون هایی که میخوان از سمت کاتو درکت کنن"
  },
  {
   "start": 1403.17,
   "end": 1404.61,
   "text": "برای سمت آنود"
  },
  {
   "start": 1404.61,
   "end": 1407.49,
   "text": "اینا میان با مولوکول های هوا برخورد میکنن"
  },
  {
   "start": 1407.49,
   "end": 1410.13,
   "text": "انرژی در واقع از دست مینه"
  },
  {
   "start": 1410.13,
   "end": 1412.25,
   "text": "انرژی این الکترون ها که هاش پیدا میکنه"
  },
  {
   "start": 1412.25,
   "end": 1415.23,
   "text": "و با حاصل تغییرات خیلی وسیعی"
  },
  {
   "start": 1415.23,
   "end": 1419.67,
   "text": "تو جریان لامب و انرژی پرتوهای رونتیر هستن"
  },
  {
   "start": 1419.67,
   "end": 1420.67,
   "text": "که اونجا تولید میشه"
  },
  {
   "start": 1420.67,
   "end": 1424.51,
   "text": "بنابراین میان خود داخل لامب رو از هوا خالی میکنن"
  },
  {
   "start": 1424.51,
   "end": 1428.57,
   "text": "که در واقع این اجازه رو با ما میده که ما بتونیم در واقع بیندن"
  },
  {
   "start": 1428.57,
   "end": 1431.33,
   "text": "الکترون هایی که سمت کاتل تولید میشن"
  },
  {
   "start": 1431.33,
   "end": 1435.37,
   "text": "با سرعت مناسب و یک دست که سرعت نوره حرکت کنن"
  },
  {
   "start": 1435.37,
   "end": 1442.52,
   "text": "سیم های ارتباطی تو دیوار شیشه میان قرار میدن"
  },
  {
   "start": 1442.52,
   "end": 1446.46,
   "text": "یالا میان بعدش آب بندیش هم می کنن که هیچ مشکلی ندار شده باشه"
  },
  {
   "start": 1446.46,
   "end": 1449.7,
   "text": "که هنگامی که ما میان از لامف استفاده می کنیم"
  },
  {
   "start": 1449.7,
   "end": 1453.76,
   "text": "این سیم ها و شیشه بسیار داغ می شن"
  },
  {
   "start": 1453.76,
   "end": 1462.8,
   "text": "و باعث میشن این در واقع سیم ها گرما رو توسط یه سری روتور هایی که پشت لامب قرار گرفتن به بیرون منتقل کنه"
  },
  {
   "start": 1462.8,
   "end": 1466.38,
   "text": "بناماری میان در واقع از پیرکس استفاده میکنن"
  },
  {
   "start": 1466.38,
   "end": 1470.18,
   "text": "یعنی از پشتش شیشه استفاده میکنن"
  },
  {
   "start": 1470.18,
   "end": 1475.76,
   "text": "چرا به خاطر این که این پشتش شیشه پرتو ایکسی که طولید میشه"
  },
  {
   "start": 1475.76,
   "end": 1478.32,
   "text": "خیلی کم به خودش جز میکنه اجازه میده"
  },
  {
   "start": 1478.32,
   "end": 1482.18,
   "text": "اون پرتو ایکس طولی شده بیشتر از شیشه عبور پیدا کنه"
  },
  {
   "start": 1482.18,
   "end": 1484.76,
   "text": "انرژیش به حوالتی کاهش پیدا نکنه"
  },
  {
   "start": 1484.76,
   "end": 1488.46,
   "text": "خودش شیشه آیق بسیار خوبی"
  },
  {
   "start": 1488.46,
   "end": 1492.14,
   "text": "برای در واقع الکتریسیته"
  },
  {
   "start": 1492.14,
   "end": 1495.76,
   "text": "و همچنین انتشار حرارتی مناسبی داره"
  },
  {
   "start": 1495.76,
   "end": 1499.26,
   "text": "وقتی ما از شیشه تو بدنه لامپ استفاده میگنیم"
  },
  {
   "start": 1499.26,
   "end": 1501.88,
   "text": "خدمت شما ارز کردیم"
  },
  {
   "start": 1501.88,
   "end": 1504.34,
   "text": "خود لامپ پرتویس یه سمتش کاتوده"
  },
  {
   "start": 1504.34,
   "end": 1507.72,
   "text": "که سر منفی لامپ های پرتویس بهش میگن"
  },
  {
   "start": 1507.72,
   "end": 1509.4,
   "text": "چه اتفاق میفته؟"
  },
  {
   "start": 1509.4,
   "end": 1514.04,
   "text": "اون قسمتی که کاتود و فیلامانی از جنس تنگستن قرار گرفته"
  },
  {
   "start": 1514.04,
   "end": 1520.44,
   "text": "می آین در واقع یک جریان سه تا پنج آمپری به این فیلامان می دن"
  },
  {
   "start": 1520.44,
   "end": 1522.24,
   "text": "این فیلامانه گرم می شه"
  },
  {
   "start": 1522.24,
   "end": 1527.16,
   "text": "فیلامانه که گرم می شه طبق پدیده ترمویونیک بهش می گن"
  },
  {
   "start": 1527.16,
   "end": 1532.1,
   "text": "طبق این پدیده در اصل گرم کردن فیلامان الکترون تولید می شه"
  },
  {
   "start": 1532.1,
   "end": 1536.4,
   "text": "این الکترون تولید شده این سمت کاتود قرار می گیره"
  },
  {
   "start": 1536.4,
   "end": 1539.7,
   "text": "میان در واقع گفتن خدمتون"
  },
  {
   "start": 1539.7,
   "end": 1542.0,
   "text": "فیلمان رو از جنس تنگستن می سازن"
  },
  {
   "start": 1542.0,
   "end": 1543.8,
   "text": "چرا از جنس تنگستن می سازن"
  },
  {
   "start": 1543.8,
   "end": 1546.04,
   "text": "چرا از تنگستن اصلا استفاده می کنن"
  },
  {
   "start": 1546.04,
   "end": 1547.48,
   "text": "به خاطر اینکه عزیزان"
  },
  {
   "start": 1547.48,
   "end": 1549.74,
   "text": "تنگستن به راحتی"
  },
  {
   "start": 1549.74,
   "end": 1551.96,
   "text": "به شکل یه سیمه نازور در می آ"
  },
  {
   "start": 1551.96,
   "end": 1553.54,
   "text": "محکمه"
  },
  {
   "start": 1553.54,
   "end": 1555.86,
   "text": "نقطه زوبه خیلی بالایی داره"
  },
  {
   "start": 1555.86,
   "end": 1558.16,
   "text": "در حد 3.370 درجه"
  },
  {
   "start": 1558.16,
   "end": 1559.88,
   "text": "سانتیگراد حرارت"
  },
  {
   "start": 1559.88,
   "end": 1561.58,
   "text": "رو می تونه تحمل کنه"
  },
  {
   "start": 1561.58,
   "end": 1564.34,
   "text": "و خیلی کم تبخیر می شه خود تنگستن"
  },
  {
   "start": 1564.34,
   "end": 1566.28,
   "text": "حالا این اتفاقی که میوفته ما"
  },
  {
   "start": 1566.28,
   "end": 1567.58,
   "text": "معمولا کاری که ما خواهد انجامونه"
  },
  {
   "start": 1567.58,
   "end": 1571.1,
   "text": "گاهن پیش نه تا دو هزار و دیویس درجه سانتگیرات"
  },
  {
   "start": 1571.1,
   "end": 1572.3,
   "text": "باید این فیلمانه گرم میشه"
  },
  {
   "start": 1572.3,
   "end": 1575.02,
   "text": "پس اموردین ما میام از تنگستان استفاده میدونیم"
  },
  {
   "start": 1575.02,
   "end": 1577.88,
   "text": "که خلالی توی کار ما ایجار نکنه"
  },
  {
   "start": 1577.88,
   "end": 1579.74,
   "text": "پس طبق پدیده ترمویونیک"
  },
  {
   "start": 1579.74,
   "end": 1581.06,
   "text": "در اصدار جریان"
  },
  {
   "start": 1581.06,
   "end": 1584.02,
   "text": "سه تا پنج آمپری که ما به کاتود میدیم"
  },
  {
   "start": 1584.02,
   "end": 1586.0,
   "text": "قسمت کاتود یک عبر"
  },
  {
   "start": 1586.0,
   "end": 1587.18,
   "text": "الیکترونیکی ایجار میشه"
  },
  {
   "start": 1587.18,
   "end": 1588.62,
   "text": "بهش میگن فضای بار"
  },
  {
   "start": 1588.62,
   "end": 1590.52,
   "text": "اسپیس چارژ"
  },
  {
   "start": 1590.52,
   "end": 1594.04,
   "text": "این اپ داره بار منفیه"
  },
  {
   "start": 1594.04,
   "end": 1595.24,
   "text": "و باعث میشه"
  },
  {
   "start": 1595.24,
   "end": 1597.34,
   "text": "الکترون های دیگه از فیلامان"
  },
  {
   "start": 1597.34,
   "end": 1598.96,
   "text": "که الان میان در واقع تولید میشن"
  },
  {
   "start": 1598.96,
   "end": 1600.02,
   "text": "جلو گریه کنیم"
  },
  {
   "start": 1600.02,
   "end": 1602.6,
   "text": "ما معمولا یک اثر فضای بار بهش میگن"
  },
  {
   "start": 1602.6,
   "end": 1604.62,
   "text": "عزیزان من"
  },
  {
   "start": 1604.62,
   "end": 1606.62,
   "text": "این الکترون هایی که تولید میشن"
  },
  {
   "start": 1606.62,
   "end": 1608.66,
   "text": "سمت کاتود یک عبر الکترونی"
  },
  {
   "start": 1608.66,
   "end": 1610.02,
   "text": "که خدمت شما عرض کردیم"
  },
  {
   "start": 1610.02,
   "end": 1612.08,
   "text": "این عبر الکترونی باید حرکت کنه"
  },
  {
   "start": 1612.08,
   "end": 1613.0,
   "text": "برای به سمت آن"
  },
  {
   "start": 1613.0,
   "end": 1614.22,
   "text": "در واقع آنود"
  },
  {
   "start": 1614.22,
   "end": 1616.24,
   "text": "چون این عبر الکترونه"
  },
  {
   "start": 1616.24,
   "end": 1618.64,
   "text": "همه گی با بار منفی هستن"
  },
  {
   "start": 1618.64,
   "end": 1620.48,
   "text": "باید کاری کنیم که این"
  },
  {
   "start": 1620.48,
   "end": 1623.08,
   "text": "الکترون ها در هین حرکت به سمت آنود"
  },
  {
   "start": 1623.08,
   "end": 1624.66,
   "text": "انرژیشون"
  },
  {
   "start": 1624.66,
   "end": 1626.18,
   "text": "کاهش پیدا نکنه"
  },
  {
   "start": 1626.18,
   "end": 1628.24,
   "text": "متفرق نشن"
  },
  {
   "start": 1628.24,
   "end": 1630.66,
   "text": "چون بارهای همنام همدیگر رو"
  },
  {
   "start": 1630.66,
   "end": 1632.66,
   "text": "دفت میکنن باید نشه که"
  },
  {
   "start": 1632.66,
   "end": 1634.7,
   "text": "این الکترون ها دور بشن"
  },
  {
   "start": 1634.7,
   "end": 1636.34,
   "text": "و به هدف ما برخور نکنن"
  },
  {
   "start": 1636.34,
   "end": 1637.86,
   "text": "بنابراین میان چکار میکنن"
  },
  {
   "start": 1637.86,
   "end": 1640.24,
   "text": "از یک سرپوش کانونی یا استرامبش میگن"
  },
  {
   "start": 1640.24,
   "end": 1641.18,
   "text": "فوکوسین کپ"
  },
  {
   "start": 1641.18,
   "end": 1644.68,
   "text": "استفاده میکنن که این فیلامانو احاطه میکنه"
  },
  {
   "start": 1644.68,
   "end": 1646.48,
   "text": "و باعث میشه"
  },
  {
   "start": 1646.48,
   "end": 1648.26,
   "text": "این در واقع فوکوسین کپی"
  },
  {
   "start": 1648.26,
   "end": 1650.42,
   "text": "که ما استفاده میکنیم"
  },
  {
   "start": 1650.42,
   "end": 1652.2,
   "text": "داره پتانسیل منفیه"
  },
  {
   "start": 1652.2,
   "end": 1654.52,
   "text": "در واقع الکترودهای"
  },
  {
   "start": 1654.52,
   "end": 1655.8,
   "text": "از جنس مولیبلیوم"
  },
  {
   "start": 1655.8,
   "end": 1657.44,
   "text": "یا در واقع نیکل هستن"
  },
  {
   "start": 1657.44,
   "end": 1659.8,
   "text": "این دوتا الکترودی که استفاده میکنن"
  },
  {
   "start": 1659.8,
   "end": 1662.2,
   "text": "دو سر در واقع"
  },
  {
   "start": 1662.2,
   "end": 1663.88,
   "text": "لامپ پرتوی ایکس"
  },
  {
   "start": 1663.88,
   "end": 1665.82,
   "text": "هر دوتا بارشون منفیه"
  },
  {
   "start": 1665.82,
   "end": 1667.58,
   "text": "باعث میشه وقتی که این الکترودهای"
  },
  {
   "start": 1667.58,
   "end": 1669.52,
   "text": "با بار منفی به این الکترون ها"
  },
  {
   "start": 1669.52,
   "end": 1670.54,
   "text": "نزدیک بشن"
  },
  {
   "start": 1670.54,
   "end": 1672.24,
   "text": "اینا رو بازم اجازه نده"
  },
  {
   "start": 1672.24,
   "end": 1674.4,
   "text": "که زیاد به الکترون نزدیک بشن"
  },
  {
   "start": 1674.4,
   "end": 1675.64,
   "text": "دوره از خودش دف میکنه"
  },
  {
   "start": 1675.64,
   "end": 1678.16,
   "text": "باس میشه این الکترون ها تو مسیر مستقیم"
  },
  {
   "start": 1678.16,
   "end": 1679.34,
   "text": "حرکت کنن"
  },
  {
   "start": 1679.34,
   "end": 1681.86,
   "text": "بنابراین اسپوکوسینکه استفاده میکنن"
  },
  {
   "start": 1681.86,
   "end": 1684.82,
   "text": "که این الکترون ها متفرق به عبارت این نشن"
  },
  {
   "start": 1684.82,
   "end": 1686.76,
   "text": "قسمت آنود ما که به اسم بیش میگن"
  },
  {
   "start": 1686.76,
   "end": 1688.7,
   "text": "خطب مصبت لامف پرتویس"
  },
  {
   "start": 1688.7,
   "end": 1690.84,
   "text": "هم ثابت وجود داره"
  },
  {
   "start": 1690.84,
   "end": 1692.12,
   "text": "هم به حالت چرک ها"
  },
  {
   "start": 1692.12,
   "end": 1696.02,
   "text": "آنوده که قبلا ثابت می ساختن"
  },
  {
   "start": 1696.02,
   "end": 1699.12,
   "text": "یک صفحه کوچه که بازم از جنس تنگستن بود"
  },
  {
   "start": 1699.12,
   "end": 1701.1,
   "text": "گفتم چرا از تنگستن استفاده می کنن"
  },
  {
   "start": 1701.1,
   "end": 1704.36,
   "text": "پس به نورین هم قسمت کاتود ما از جنس تنگستن"
  },
  {
   "start": 1704.36,
   "end": 1708.56,
   "text": "هم قسمت آنود ما در واقع از تنگستن استفاده می کنن"
  },
  {
   "start": 1708.56,
   "end": 1711.8,
   "text": "یک در واقع زخامت دوسته میلیمتری از تنگستن"
  },
  {
   "start": 1711.8,
   "end": 1714.9,
   "text": "توی یک بلوک بزرگ مسی قرار می دن"
  },
  {
   "start": 1714.9,
   "end": 1717.88,
   "text": "که حالا هدف از استفاده از این بلوک مسی اینه"
  },
  {
   "start": 1717.88,
   "end": 1721.34,
   "text": "که بتونه انتقال و دفع گرم ها خیلی بهتری داشته باشه"
  },
  {
   "start": 1721.34,
   "end": 1724.48,
   "text": "زاویه معمولا به آنود میدن"
  },
  {
   "start": 1724.48,
   "end": 1727.44,
   "text": "زاویه حدود 15 تا 20 درجه"
  },
  {
   "start": 1727.44,
   "end": 1731.08,
   "text": "و که با دادن این زاویه سطح محسری که باعث میشه"
  },
  {
   "start": 1731.08,
   "end": 1732.44,
   "text": "که این الکترون ها بخور کنن"
  },
  {
   "start": 1732.44,
   "end": 1733.9,
   "text": "به عبارت ما بیشتر کردیم"
  },
  {
   "start": 1733.9,
   "end": 1738.0,
   "text": "و به عبارتی فوتون ایکس بیشتری به ما میده"
  },
  {
   "start": 1738.0,
   "end": 1741.84,
   "text": "که ما میتونه از اون فوتون ایکس برای کارامون استفاده کنیم"
  },
  {
   "start": 1741.84,
   "end": 1751.98,
   "text": "کاتود رو گفتیم چرا آنود رو از تنگستان استفاده می کنیم"
  },
  {
   "start": 1751.98,
   "end": 1754.7,
   "text": "ما هم دلائلی مثل همون چیده که قبل گفتیم"
  },
  {
   "start": 1754.7,
   "end": 1757.04,
   "text": "عدد اطومین بالایی داره حدوداً 74"
  },
  {
   "start": 1757.04,
   "end": 1763.1,
   "text": "که برای تشخیص توی راژویجه تشخیصی برای ما خیلی کارایی داره"
  },
  {
   "start": 1763.1,
   "end": 1769.8,
   "text": "نقطه زوب بالا که قبلاً گفتم تا 3370 درجه سانتگران میتونه تحمل حرارتی داشته باشه"
  },
  {
   "start": 1769.8,
   "end": 1772.76,
   "text": "این ماده تنگستان در جزب"
  },
  {
   "start": 1772.76,
   "end": 1775.0,
   "text": "انتقال و پراکنده سازی"
  },
  {
   "start": 1775.0,
   "end": 1776.28,
   "text": "گرم میتونه به خوبی"
  },
  {
   "start": 1776.28,
   "end": 1777.52,
   "text": "عمل کنه"
  },
  {
   "start": 1777.52,
   "end": 1780.18,
   "text": "اینا در واقع مواردی بود که"
  },
  {
   "start": 1780.18,
   "end": 1781.82,
   "text": "از تنگستان استفاده میتونه"
  },
  {
   "start": 1781.82,
   "end": 1783.7,
   "text": "چرا آنود رو میچرخونن"
  },
  {
   "start": 1783.7,
   "end": 1786.34,
   "text": "عزیزان بیمین قبلا آنود ثابت بود"
  },
  {
   "start": 1786.34,
   "end": 1788.2,
   "text": "آنود همینجور که میگم دست من رو"
  },
  {
   "start": 1788.2,
   "end": 1790.46,
   "text": "مشاهده میفرمیم بارات شیب دار قرار گرفته"
  },
  {
   "start": 1790.46,
   "end": 1792.76,
   "text": "گفتم 15 تا 20 درجه شیب میدن"
  },
  {
   "start": 1792.76,
   "end": 1794.58,
   "text": "که این سطح محسری که"
  },
  {
   "start": 1794.58,
   "end": 1796.96,
   "text": "الکترون برخورد میکنه"
  },
  {
   "start": 1796.96,
   "end": 1797.7,
   "text": "بیشتر بشه"
  },
  {
   "start": 1797.7,
   "end": 1800.02,
   "text": "آنودو میان چرخان میسازن"
  },
  {
   "start": 1800.02,
   "end": 1801.38,
   "text": "چقدر میچرخه"
  },
  {
   "start": 1801.38,
   "end": 1803.68,
   "text": "سه هزار دور در دقیقه"
  },
  {
   "start": 1803.68,
   "end": 1806.0,
   "text": "وقتی آنودو چرخان میسازن"
  },
  {
   "start": 1806.0,
   "end": 1808.4,
   "text": "باعث میشه بازم تحمل گرماییش"
  },
  {
   "start": 1808.4,
   "end": 1809.88,
   "text": "بیشتر بشه"
  },
  {
   "start": 1809.88,
   "end": 1811.66,
   "text": "نسبت به آنودهای ثابت"
  },
  {
   "start": 1811.66,
   "end": 1813.98,
   "text": "و این باعث میشه که آنود دیرتر"
  },
  {
   "start": 1813.98,
   "end": 1814.82,
   "text": "تخریب بشه"
  },
  {
   "start": 1814.82,
   "end": 1816.52,
   "text": "دیرتر به عبارتی"
  },
  {
   "start": 1816.52,
   "end": 1819.4,
   "text": "دوچار فرو رفتگی و"
  },
  {
   "start": 1819.4,
   "end": 1821.3,
   "text": "نا همواری بشه"
  },
  {
   "start": 1821.3,
   "end": 1823.88,
   "text": "که خودش باعث خرابی آنود میشه"
  },
  {
   "start": 1823.88,
   "end": 1825.6,
   "text": "پس منوارین باعث میشه"
  },
  {
   "start": 1825.6,
   "end": 1827.84,
   "text": "کارایی ما"
  },
  {
   "start": 1827.84,
   "end": 1829.72,
   "text": "در استفاده از آنود بیشتر بشه"
  },
  {
   "start": 1829.72,
   "end": 1831.64,
   "text": "حالا میام به خود آنودن یه مقداری"
  },
  {
   "start": 1831.64,
   "end": 1833.7,
   "text": "رنیوم اضاف می کنن که مقاوت"
  },
  {
   "start": 1833.7,
   "end": 1835.02,
   "text": "سطیش رو افزهش بدن"
  },
  {
   "start": 1835.02,
   "end": 1837.84,
   "text": "من چند تا واجه رو"
  },
  {
   "start": 1837.84,
   "end": 1839.76,
   "text": "خدمت شما توضیح بدم در چند تا"
  },
  {
   "start": 1839.76,
   "end": 1841.78,
   "text": "اسلاید و بعدش بحثم رو تموم می کنم"
  },
  {
   "start": 1841.78,
   "end": 1844.14,
   "text": "مولد پرتو ایکس ما یه چند تا"
  },
  {
   "start": 1844.14,
   "end": 1846.08,
   "text": "واجه داریم بهش میگن کمیت"
  },
  {
   "start": 1846.08,
   "end": 1847.76,
   "text": "و کیفیت عزیزان هر جا"
  },
  {
   "start": 1847.76,
   "end": 1849.78,
   "text": "صحبت از کمیت شد یعنی شدت"
  },
  {
   "start": 1849.78,
   "end": 1852.18,
   "text": "پرتو شدت پرتو"
  },
  {
   "start": 1852.18,
   "end": 1854.48,
   "text": "چیه؟ تعداد فوتون های"
  },
  {
   "start": 1854.48,
   "end": 1856.3,
   "text": "عبوری از وعده ست در وعده"
  },
  {
   "start": 1856.3,
   "end": 1857.6,
   "text": "زمان بهش میگن کمیه"
  },
  {
   "start": 1857.6,
   "end": 1860.28,
   "text": "کیفیت چیه؟ کیفیت هر ایتا"
  },
  {
   "start": 1860.28,
   "end": 1861.94,
   "text": "صحبت شد یعنی قدرت و نفوز"
  },
  {
   "start": 1861.94,
   "end": 1864.32,
   "text": "یعنی انرژی پرتو ایکس"
  },
  {
   "start": 1864.32,
   "end": 1866.52,
   "text": "این خیلی مهمه که پس کیفیت"
  },
  {
   "start": 1866.52,
   "end": 1868.36,
   "text": "معرف قدرت و نفوز و انرژی"
  },
  {
   "start": 1868.36,
   "end": 1870.54,
   "text": "کمیت معرف شدت"
  },
  {
   "start": 1870.54,
   "end": 1871.42,
   "text": "پرتو ایکسه"
  },
  {
   "start": 1871.42,
   "end": 1873.96,
   "text": "که ما الان گفتیم شدت معرف"
  },
  {
   "start": 1873.96,
   "end": 1876.22,
   "text": "در واقع تعداد"
  },
  {
   "start": 1876.22,
   "end": 1878.28,
   "text": "پرتو ایکسه که با افضایش پرتا"
  },
  {
   "start": 1878.28,
   "end": 1880.72,
   "text": "شدت پرتو هم بیشتر میشن"
  },
  {
   "start": 1880.72,
   "end": 1882.52,
   "text": "جریان لامف گفتیم"
  },
  {
   "start": 1882.52,
   "end": 1883.84,
   "text": "معرف خود شدت"
  },
  {
   "start": 1883.84,
   "end": 1886.74,
   "text": "که هر چقدر میلی آمپر زیادتر"
  },
  {
   "start": 1886.74,
   "end": 1888.32,
   "text": "بشه الکترون های بیشتری"
  },
  {
   "start": 1888.32,
   "end": 1890.36,
   "text": "طبیعتاً رسمت کاتو تولید میشن"
  },
  {
   "start": 1890.36,
   "end": 1892.36,
   "text": "و در نتیجه ما میتونیم فوتونا"
  },
  {
   "start": 1892.36,
   "end": 1894.6,
   "text": "ایس بیشتری هم تولید کنیم"
  },
  {
   "start": 1894.6,
   "end": 1896.94,
   "text": "ببینیم من تو این استرائیدی که ما شاهده میفرماییم"
  },
  {
   "start": 1896.94,
   "end": 1898.52,
   "text": "به زبان خیلی ساده"
  },
  {
   "start": 1898.52,
   "end": 1900.48,
   "text": "این کیفیت و کمیت رو توضیح دادم"
  },
  {
   "start": 1900.48,
   "end": 1902.36,
   "text": "مثلا شما همینجا که ملازم می فرمایید"
  },
  {
   "start": 1902.36,
   "end": 1904.14,
   "text": "گفتیم اینجا کیوی پایینه"
  },
  {
   "start": 1904.14,
   "end": 1906.26,
   "text": "کیوی یعنی قدرت و نفوز"
  },
  {
   "start": 1906.26,
   "end": 1908.3,
   "text": "یعنی به عبارتی"
  },
  {
   "start": 1908.3,
   "end": 1910.66,
   "text": "انرژی پرتوها"
  },
  {
   "start": 1910.66,
   "end": 1911.44,
   "text": "کمه"
  },
  {
   "start": 1911.44,
   "end": 1913.84,
   "text": "وقتی ما کیوی رو زیاد می کنیم چه اتفاق می کنم"
  },
  {
   "start": 1913.84,
   "end": 1915.98,
   "text": "همین پرتو رو که شما ملازم می فرماییم"
  },
  {
   "start": 1915.98,
   "end": 1918.1,
   "text": "با سرعت بالاتری برخور می کنه"
  },
  {
   "start": 1918.1,
   "end": 1920.64,
   "text": "سرعت بیشتر یعنی قدرت و نفوز"
  },
  {
   "start": 1920.64,
   "end": 1922.26,
   "text": "بیشتری به داخل ماده هدف"
  },
  {
   "start": 1922.26,
   "end": 1924.54,
   "text": "یعنی فوتون ایکس هم پیتوری می شه"
  },
  {
   "start": 1924.54,
   "end": 1929.02,
   "text": "چون در لایه های امگه اتم و هدف نفوستون است پیدا کنه"
  },
  {
   "start": 1929.02,
   "end": 1931.82,
   "text": "طبیعتاً انرژی بیشتری هم برای ما تولیل می کنه"
  },
  {
   "start": 1931.82,
   "end": 1933.18,
   "text": "صحبت از میلی آمپر شد"
  },
  {
   "start": 1933.18,
   "end": 1934.92,
   "text": "گفتی میلی آمپر معرف شدته"
  },
  {
   "start": 1934.92,
   "end": 1936.62,
   "text": "اینجا میلی آمپر کم"
  },
  {
   "start": 1936.62,
   "end": 1940.84,
   "text": "ببینی الان مثلا حدوداً چار تا الکترونه که میره سمت آنود"
  },
  {
   "start": 1940.84,
   "end": 1945.26,
   "text": "و برای ما طبیعتاً تولید فوتون به اندازه همین چار تا الکترون رو می کنه"
  },
  {
   "start": 1945.26,
   "end": 1947.08,
   "text": "وقتی میگیم میلی آمپر بالا"
  },
  {
   "start": 1947.08,
   "end": 1949.44,
   "text": "یعنی تعداد الکترون هایی که"
  },
  {
   "start": 1949.44,
   "end": 1951.0,
   "text": "حرکت میکنن از سمت"
  },
  {
   "start": 1951.0,
   "end": 1953.2,
   "text": "کاتول و به سمت آنود میرسن"
  },
  {
   "start": 1953.2,
   "end": 1954.82,
   "text": "بیشتره طبیعتا تعداد"
  },
  {
   "start": 1954.82,
   "end": 1956.76,
   "text": "فوتونه ما بیشتر به عبارتی شدت"
  },
  {
   "start": 1956.76,
   "end": 1958.94,
   "text": "بالاتر. این در واقع نکاتی بود"
  },
  {
   "start": 1958.94,
   "end": 1960.86,
   "text": "که گفتم خدمت شما عرض کنم"
  },
  {
   "start": 1960.86,
   "end": 1963.14,
   "text": "خب برای این جلسه تا همینقدر"
  },
  {
   "start": 1963.14,
   "end": 1964.72,
   "text": "که توضیح دادم کافی میدونم"
  },
  {
   "start": 1964.72,
   "end": 1967.14,
   "text": "انشاءالله بقیه موارد رو در جلسات"
  },
  {
   "start": 1967.14,
   "end": 1968.62,
   "text": "بعد خدمت شما عزیزان"
  },
  {
   "start": 1968.62,
   "end": 1970.86,
   "text": "عرض خواهم کرد. از این که تا اینجا"
  },
  {
   "start": 1970.86,
   "end": 1973.1,
   "text": "فیلم رو دیدیم و صحبت های بنده رو گوش کردیم"
  },
  {
   "start": 1973.1,
   "end": 1974.0,
   "text": "صفاظ کذارم"
  },
  {
   "start": 1974.0,
   "end": 1976.72,
   "text": "برای شما عزیزان آروزه سلامتی و"
  },
  {
   "start": 1976.72,
   "end": 1979.18,
   "text": "موافقیت دارم تا دیداری مجدد"
  },
  {
   "start": 1979.18,
