[
 {
  "start": 9.07,
  "end": 46.41,
  "text": "بسم الله الرحمن الرحیم، با سلام خدمت دانشجویان عزیز، مطالبی که در درس فیزیک پزشکی صحبت میشه، حالا شامل سری مطالب هست که همکاران خدمتتون میگن در مورد حالا رادیوبیولوژی، تأثیر پرتوها روی بافتها در خصوص تولید پرتوهای X،"
 },
 {
  "start": 46.41,
  "end": 54.73,
  "text": "در طریقه تشکیل تصویر استفاده از این پرتوهای ایکس در پزشکی و موارد دیگر"
 },
 {
  "start": 54.73,
  "end": 70.47,
  "text": "منطقه مطالبی که من بیان می کنم شامل حالا یه مقداری تشعشو و انواع تشعشو هست"
 },
 {
  "start": 70.47,
  "end": 81.77,
  "text": "که بحث و فکوس می کنیم روی تشاشات زرعی ماننده پرتوهای آلفا و بتا و موارد دیگر"
 },
 {
  "start": 81.77,
  "end": 92.03,
  "text": "و طریقه در حقیقت تولید این پرتوها و استحاله این پرتوها از مواد راژیو اکتیو"
 },
 {
  "start": 92.03,
  "end": 95.21,
  "text": "و خصوصیات اونها صحبت میکنیم"
 },
 {
  "start": 95.21,
  "end": 100.61,
  "text": "راجع به مواد راژیو اکتیف صحبت میکنیم"
 },
 {
  "start": 100.61,
  "end": 104.97,
  "text": "انواع استحالها صحبت میکنیم"
 },
 {
  "start": 104.97,
  "end": 115.0,
  "text": "آشیها و کاربوردهای اونا را توی پزشکی میگیم"
 },
 {
  "start": 115.0,
  "end": 118.04,
  "text": "یعنی از این مواد راژیو اکتیف یا تشعرشات راژیو اکتیف"
 },
 {
  "start": 118.04,
  "end": 125.64,
  "text": "ما چه کاربورد بالینی تشخیصی و درمانی میکنیم"
 },
 {
  "start": 125.64,
  "end": 131.74,
  "text": "که حالا راجب کاربورد های مواد راژی اکتیو در پزشکی"
 },
 {
  "start": 131.74,
  "end": 135.68,
  "text": "راجب پزشکی هستهی مطالبی میگیم"
 },
 {
  "start": 135.68,
  "end": 141.76,
  "text": "راجب کاربورد درمانیشون یا همون راژیو ترابی مطالبی صحبت میکنیم"
 },
 {
  "start": 141.76,
  "end": 146.78,
  "text": "و ادامه اون هم راجب تصفیر ورداری با انواج فراسوکی"
 },
 {
  "start": 146.78,
  "end": 152.0,
  "text": "یا همون سونوگرافی مطالبی میگیم خدمتتون"
 },
 {
  "start": 152.0,
  "end": 167.49,
  "text": "خب ردیشن کلن تشعشو یعنی انتشار انرژی از خلا و ماده"
 },
 {
  "start": 167.49,
  "end": 170.55,
  "text": "این میگن حالا تعریف تشعشو هست که"
 },
 {
  "start": 170.55,
  "end": 172.83,
  "text": "تشعشو یه نوع انرژی هست دیگه"
 },
 {
  "start": 172.83,
  "end": 176.39,
  "text": "بلاخره خودش میگن موقع انرژی را تقسیم بندی میکنن"
 },
 {
  "start": 176.39,
  "end": 178.05,
  "text": "میگن انرژی تشعشوی"
 },
 {
  "start": 178.05,
  "end": 183.71,
  "text": "خب پس تشعشو شد انتشار انرژی از خلا و ماده"
 },
 {
  "start": 183.71,
  "end": 191.03,
  "text": "این تعریف تشعرش هست که این تشعرشات میتونن به صورت پرتوهای ذرعی باشن"
 },
 {
  "start": 191.03,
  "end": 194.29,
  "text": "یا پرتوهای الیکترو مقناطیست"
 },
 {
  "start": 194.29,
  "end": 206.55,
  "text": "پرتوهای ذرعی بسته به این که بار داشته باشن"
 },
 {
  "start": 206.55,
  "end": 215.09,
  "text": "یا بدون بار ما به دو دست تشعرشات ذرعی باردار و بدون بار"
 },
 {
  "start": 215.09,
  "end": 216.89,
  "text": "تقسیم بندی میشن"
 },
 {
  "start": 216.89,
  "end": 218.69,
  "text": "تشاشات زرعی باردار"
 },
 {
  "start": 218.69,
  "end": 221.01,
  "text": "مثل الکترون مثل پروتون"
 },
 {
  "start": 221.01,
  "end": 222.79,
  "text": "مثل نگاترون"
 },
 {
  "start": 222.79,
  "end": 224.69,
  "text": "یا بتای منفی"
 },
 {
  "start": 224.69,
  "end": 226.09,
  "text": "مثل بتای مصبت"
 },
 {
  "start": 226.09,
  "end": 227.59,
  "text": "یا پوزیترون"
 },
 {
  "start": 227.59,
  "end": 231.85,
  "text": "دارای جرم هستن"
 },
 {
  "start": 231.85,
  "end": 233.31,
  "text": "دارای بار هستن"
 },
 {
  "start": 233.31,
  "end": 235.33,
  "text": "سرعت های متفاوتی دارن"
 },
 {
  "start": 235.33,
  "end": 245.58,
  "text": "توهای زرعی"
 },
 {
  "start": 245.58,
  "end": 247.32,
  "text": "الفا و بتا"
 },
 {
  "start": 247.32,
  "end": 250.12,
  "text": "ها را یه سری خصوصیات"
 },
 {
  "start": 250.12,
  "end": 251.54,
  "text": "خاص خودشون رو دارن"
 },
 {
  "start": 251.54,
  "end": 254.77,
  "text": "و"
 },
 {
  "start": 254.77,
  "end": 263.33,
  "text": "و بدون بار هم مثل نوترون یک تششعه زرعی بدون بارخستش"
 },
 {
  "start": 263.33,
  "end": 268.26,
  "text": "حالا توی این جدول شما مشخصاته"
 },
 {
  "start": 268.26,
  "end": 273.08,
  "text": "بعضا پرتوهای زرعی مثل آلفا به تای مصبت به تای منفی"
 },
 {
  "start": 273.08,
  "end": 275.62,
  "text": "یا نوترون را مشاهده می فرمایید"
 },
 {
  "start": 275.62,
  "end": 279.96,
  "text": "در نظر حالا بار و جرم و قدرت نفوزش"
 },
 {
  "start": 279.96,
  "end": 282.26,
  "text": "یا بردش"
 },
 {
  "start": 282.26,
  "end": 289.42,
  "text": "خب که بعدا بهش می پردازیم"
 },
 {
  "start": 289.42,
  "end": 307.91,
  "text": "قدرت نفوز پرتوهای زرعی بستگی به جرم داره و بار و سرعت اونها داره"
 },
 {
  "start": 307.91,
  "end": 316.13,
  "text": "که هرچی جرم این پرتوهای زرعی بیشتر باشد"
 },
 {
  "start": 316.13,
  "end": 323.11,
  "text": "بارشون بیشتر باشد و سرعت اونها کمتر باشد"
 },
 {
  "start": 323.11,
  "end": 331.72,
  "text": "قدرت نفوز یا برد کمتری دارند"
 },
 {
  "start": 331.72,
  "end": 337.7,
  "text": "مثل مثلا زرعه آلفا که خب جرمش چار اتمیک مزیونیده"
 },
 {
  "start": 337.7,
  "end": 339.38,
  "text": "نسبت به مثلا بیتا"
 },
 {
  "start": 339.38,
  "end": 342.04,
  "text": "اون بارش بیشتره دوباره مصبته"
 },
 {
  "start": 342.04,
  "end": 346.46,
  "text": "خب سرعتش هم کمتر هست"
 },
 {
  "start": 346.46,
  "end": 351.4,
  "text": "در نتیجه بردش در هوا در حد سانتیمتر هستش"
 },
 {
  "start": 351.4,
  "end": 354.02,
  "text": "در بافت در حد میکرون هستش"
 },
 {
  "start": 354.02,
  "end": 358.26,
  "text": "منتها بیتا زرعه بیتا که جرم کمتری داره"
 },
 {
  "start": 358.26,
  "end": 360.5,
  "text": "بار کمتری داره"
 },
 {
  "start": 360.5,
  "end": 363.06,
  "text": "سرعت بیشتری داره"
 },
 {
  "start": 363.06,
  "end": 365.62,
  "text": "برد کم بردش"
 },
 {
  "start": 365.62,
  "end": 367.64,
  "text": "چی هستش هم بیشتره"
 },
 {
  "start": 367.64,
  "end": 370.96,
  "text": "در حد سانتیمه تا متر هستش"
 },
 {
  "start": 370.96,
  "end": 374.18,
  "text": "برد زره بیتا در خوا"
 },
 {
  "start": 374.18,
  "end": 378.6,
  "text": "در حالا باف در حد میلیمتر تا سانتیمتر هستش"
 },
 {
  "start": 378.6,
  "end": 387.54,
  "text": "ولی زره آلفا قدرت یونیزاسیون بالاتری داره"
 },
 {
  "start": 387.54,
  "end": 394.07,
  "text": "خطرناکتره"
 },
 {
  "start": 394.07,
  "end": 397.45,
  "text": "درجه خطرناکی بیشتری داره"
 },
 {
  "start": 397.45,
  "end": 402.05,
  "text": "میتونه آثار بیولوژیکی بیشتری به جا بزاره"
 },
 {
  "start": 402.05,
  "end": 416.77,
  "text": "که حالا ادامه راجع به حالا خصوصیاتشون و انواع استحالها و آثار آلفا و بیتا و گاما اینا صحبت میکنه"
 },
 {
  "start": 416.77,
  "end": 428.5,
  "text": "پس گفتیم که تشعرشو یا به صورت پارتیکل ذرعی هست"
 },
 {
  "start": 428.5,
  "end": 437.5,
  "text": "یا به صورت انواجه الیکترومغناطیس که پارتیکل یه سری مطالب در مورد تشاشعات ذرعی یا پارتیکل ها گفتیم"
 },
 {
  "start": 437.5,
  "end": 443.32,
  "text": "راجب پرت های الیکترومغناطیس ما فعلا تو بحثی نداریم"
 },
 {
  "start": 443.32,
  "end": 450.86,
  "text": "همکار ها اعتمالا راجب پرت های الیکترومغناطیس که حالا داره تیف گستردهی هستند صحبت کردن"
 },
 {
  "start": 450.86,
  "end": 461.68,
  "text": "و مخصوصا راجب پرتوی ایکس که میبینید یک نوع پرتوی الکترو مغناطیس هستش با طول موجه کوتا"
 },
 {
  "start": 461.68,
  "end": 468.82,
  "text": "روش حالا طولید اشعه ایس که به چی صورت اشعه ایکس توی دستگاه راژیولیشی طولید میشه"
 },
 {
  "start": 468.82,
  "end": 475.42,
  "text": "اینا همکاران یا صحبت کردن یا صحبت میکنن خدمت شما"
 },
 {
  "start": 475.42,
  "end": 480.94,
  "text": "و روش های طولید عشق ایکس و موارد دیگر"
 },
 {
  "start": 480.94,
  "end": 490.16,
  "text": "منطقه ما ادامه بس راجع به مواد راژیو اکتیو صحبت میکنیم"
 },
 {
  "start": 490.16,
  "end": 499.84,
  "text": "که این مواد راژیو اکتیو در حقیقت تشعات زرعی نیزان زرعی را ساته میکنند"
 },
 {
  "start": 499.84,
  "end": 501.38,
  "text": "نشر میدن"
 },
 {
  "start": 501.38,
  "end": 507.16,
  "text": "خب بس بحثمون شد بحث مواد راژیو اکتیف"
 },
 {
  "start": 507.16,
  "end": 516.04,
  "text": "به طور کلی مواد راژیو اکتیف موادی هستن که به طور خود به خود"
 },
 {
  "start": 516.04,
  "end": 523.32,
  "text": "از خودشان پرتوهای ساته می کنن این مواد می گن مواد راژیو اکتیف"
 },
 {
  "start": 523.32,
  "end": 529.21,
  "text": "اون پرتوهایی که از این مواد راژیو اکتیف ساته می شه"
 },
 {
  "start": 529.21,
  "end": 535.43,
  "text": "اشون میگن تحت عنوان تشعرات راژیو اکتیو"
 },
 {
  "start": 535.43,
  "end": 537.77,
  "text": "یا پرتوهای راژیو اکتیو میگن"
 },
 {
  "start": 537.77,
  "end": 539.99,
  "text": "مثل همین ورده فرمایی"
 },
 {
  "start": 539.99,
  "end": 541.93,
  "text": "ذره آلفا"
 },
 {
  "start": 541.93,
  "end": 543.49,
  "text": "بتای مصبت"
 },
 {
  "start": 543.49,
  "end": 544.57,
  "text": "بتای منفی"
 },
 {
  "start": 544.57,
  "end": 546.29,
  "text": "گاما"
 },
 {
  "start": 546.29,
  "end": 547.69,
  "text": "گاما یک نوع تشعرات"
 },
 {
  "start": 547.69,
  "end": 550.67,
  "text": "یک راژیو که از مواد راژیو اکتیو ساته میشه"
 },
 {
  "start": 550.67,
  "end": 553.69,
  "text": "که به طور کلی حالا"
 },
 {
  "start": 553.69,
  "end": 555.21,
  "text": "مواد راژیو اکتیو"
 },
 {
  "start": 555.21,
  "end": 558.49,
  "text": "یا به صورت طبیعی وجود دارن"
 },
 {
  "start": 558.49,
  "end": 560.77,
  "text": "در طبیعت مثل سریع ارانیوم"
 },
 {
  "start": 560.77,
  "end": 562.95,
  "text": "ارانیوم ارانیوم دیوستی و پنج ارانیوم دیوستی و هشت"
 },
 {
  "start": 562.95,
  "end": 564.47,
  "text": "توریوم اینا"
 },
 {
  "start": 564.47,
  "end": 566.83,
  "text": "مواد راڈیو اکتیو طبیع هستن"
 },
 {
  "start": 566.83,
  "end": 568.73,
  "text": "که در"
 },
 {
  "start": 568.73,
  "end": 570.97,
  "text": "در ظرف ملیارد ها سال"
 },
 {
  "start": 570.97,
  "end": 572.61,
  "text": "به حالا"
 },
 {
  "start": 572.61,
  "end": 575.23,
  "text": "مواد استیبل میشن"
 },
 {
  "start": 575.23,
  "end": 576.51,
  "text": "به صورب خط میشن"
 },
 {
  "start": 576.51,
  "end": 582.04,
  "text": "منطقه مواد راڈیو اکتیو"
 },
 {
  "start": 582.04,
  "end": 584.16,
  "text": "مصنوعی ما تحت شرائطی توی آزماسکان"
 },
 {
  "start": 584.16,
  "end": 586.28,
  "text": "اینا را میتونیم تولید بکنیم"
 },
 {
  "start": 586.28,
  "end": 588.64,
  "text": "مثلا نسبت نوترون پروتون"
 },
 {
  "start": 588.64,
  "end": 592.62,
  "text": "به هم میزنیم نوترون به یک مواد استیبل یا پایدار میتابونیم"
 },
 {
  "start": 592.62,
  "end": 593.96,
  "text": "راژیو اکتیف تشمی کنیم"
 },
 {
  "start": 593.96,
  "end": 600.76,
  "text": "یا مثلا توی بحث باکنش شکاف توی راکتور که به اورانیوم نوترون میتابونن"
 },
 {
  "start": 600.76,
  "end": 604.82,
  "text": "اونجا میتونه مواد راژیو اکتیف مصنوعی تولید بشه"
 },
 {
  "start": 604.82,
  "end": 607.9,
  "text": "که حالا خاید کارورت های سنتی و پزشکی هم دارن"
 },
 {
  "start": 607.9,
  "end": 614.74,
  "text": "مثل همون یود سیدسی، مثل مولیبدن، تکنیسیان، کوبالت و موارد دیگر"
 },
 {
  "start": 614.74,
  "end": 624.14,
  "text": "که ما میتونیم اون را به طور مصنوعی طوری بکنم"
 },
 {
  "start": 624.14,
  "end": 627.26,
  "text": "خب همونطور که توی این سلاید مشاهد این فرماید گفته"
 },
 {
  "start": 627.26,
  "end": 630.54,
  "text": "حالا تابش خود به خودی اش را را راژیو اکتیویته میگن"
 },
 {
  "start": 630.54,
  "end": 635.75,
  "text": "و در این مواد راژیو اکتیو"
 },
 {
  "start": 635.75,
  "end": 640.23,
  "text": "گفتم تدزیه میشند"
 },
 {
  "start": 640.23,
  "end": 648.49,
  "text": "اون عمل تدزیه یا ساته کردن پرتو"
 },
 {
  "start": 648.49,
  "end": 650.11,
  "text": "خب به وسیله مواد راژو اکتیو"
 },
 {
  "start": 650.11,
  "end": 651.73,
  "text": "بهش میگن تدزیه"
 },
 {
  "start": 651.73,
  "end": 653.17,
  "text": "یا استحاله"
 },
 {
  "start": 653.17,
  "end": 655.13,
  "text": "یا دیکی شدن"
 },
 {
  "start": 655.13,
  "end": 658.64,
  "text": "که"
 },
 {
  "start": 658.64,
  "end": 659.12,
  "text": "بون"
 },
 {
  "start": 659.12,
  "end": 662.5,
  "text": "حسته اصلی"
 },
 {
  "start": 662.5,
  "end": 664.5,
  "text": "بهش میگن حسته مادر"
 },
 {
  "start": 664.5,
  "end": 667.5,
  "text": "خب حسته راژو اکتیو"
 },
 {
  "start": 667.5,
  "end": 668.7,
  "text": "که استحاله"
 },
 {
  "start": 668.7,
  "end": 669.46,
  "text": "یا تدزیه میشه"
 },
 {
  "start": 669.46,
  "end": 670.6,
  "text": "میشه حسته مادر"
 },
 {
  "start": 670.6,
  "end": 672.76,
  "text": "اون حستهی که پس از استحاله"
 },
 {
  "start": 672.76,
  "end": 673.42,
  "text": "به وجود میاد"
 },
 {
  "start": 673.42,
  "end": 676.22,
  "text": "استحاله بهش میگن حسته دختر"
 },
 {
  "start": 676.22,
  "end": 687.78,
  "text": "و استحاله یا تدزیه مواد راژیو اکتیو به طرق مختلف صورت می گیرد"
 },
 {
  "start": 687.78,
  "end": 693.78,
  "text": "ما استحاله آلفا داریم، بتای مصبت داریم"
 },
 {
  "start": 693.78,
  "end": 697.24,
  "text": "یا پوزیترون بتای منفی داریم"
 },
 {
  "start": 697.24,
  "end": 703.14,
  "text": "یا نگاترون، تدزیه یا استحاله الکترون کپچر داریم"
 },
 {
  "start": 703.14,
  "end": 707.92,
  "text": "یا گیراندازی الکترون و واپاشی گاما داریم"
 },
 {
  "start": 707.92,
  "end": 715.02,
  "text": "که بسته به این که یک ماده رادیو اکتیو چه شرایطی دارد"
 },
 {
  "start": 715.02,
  "end": 724.92,
  "text": "از نظر عدد اطومی، از نظر تعداد نوترون ها، از نظر تعداد پروتون ها، از نظر سطح انرژی"
 },
 {
  "start": 724.92,
  "end": 732.86,
  "text": "بسته به این موارد میتونه به طرق طریقای مختلفی واپاشی بکنه"
 },
 {
  "start": 732.86,
  "end": 736.94,
  "text": "یک هسته میبینی که زره آلفا با پاشی میکنه"
 },
 {
  "start": 736.94,
  "end": 740.26,
  "text": "یک مادر راژیوکتیو میبینی با پاشی به تای مصبت"
 },
 {
  "start": 740.26,
  "end": 742.78,
  "text": "یا به تای منفی یا الکترون کپچر"
 },
 {
  "start": 742.78,
  "end": 746.5,
  "text": "بسته به اون شرایط هسته راژیوکتیو"
 },
 {
  "start": 746.5,
  "end": 751.28,
  "text": "میتونه استحاله های مختلفی انجام بده"
 },
 {
  "start": 751.28,
  "end": 755.46,
  "text": "و پرتوهای مختلفی از اون ساته بشه"
 },
 {
  "start": 755.46,
  "end": 761.2,
  "text": "پس انواع استحاله ها ما استحاله آلفا داریم"
 },
 {
  "start": 761.2,
  "end": 763.34,
  "text": "بتای مصبت"
 },
 {
  "start": 763.34,
  "end": 764.48,
  "text": "بتای منفی"
 },
 {
  "start": 764.48,
  "end": 767.94,
  "text": "الکترون کپچر و گاما"
 },
 {
  "start": 767.94,
  "end": 772.22,
  "text": "خب اینجا همینه اصلاحی دن بچه ها"
 },
 {
  "start": 772.22,
  "end": 774.92,
  "text": "اون انواع پرتهای یونیزان"
 },
 {
  "start": 774.92,
  "end": 777.3,
  "text": "را خواسته بگه که"
 },
 {
  "start": 777.3,
  "end": 779.28,
  "text": "پرتهای یونیزان"
 },
 {
  "start": 779.28,
  "end": 780.54,
  "text": "آلفا پارتیکل"
 },
 {
  "start": 780.54,
  "end": 781.46,
  "text": "بتا هستش"
 },
 {
  "start": 781.46,
  "end": 782.16,
  "text": "گاما نوتون"
 },
 {
  "start": 782.16,
  "end": 783.58,
  "text": "اینجا پرتهای یونیزان هست"
 },
 {
  "start": 783.58,
  "end": 784.76,
  "text": "توی دستگاه"
 },
 {
  "start": 784.76,
  "end": 788.74,
  "text": "توی پرتهای الکترومغناطیس بچه ها"
 },
 {
  "start": 788.74,
  "end": 790.4,
  "text": "اینجا مشاهده می فرمایید"
 },
 {
  "start": 790.4,
  "end": 792.32,
  "text": "اینجا مثلا پرتهای رادیوی"
 },
 {
  "start": 792.32,
  "end": 794.16,
  "text": "میکرو وی، انفرارید، ویزی بلاد"
 },
 {
  "start": 794.16,
  "end": 795.82,
  "text": "اینا پرتا غیر یونیزان هند"
 },
 {
  "start": 795.82,
  "end": 798.38,
  "text": "ولی ایکس و گاما یونیزان هست"
 },
 {
  "start": 798.38,
  "end": 800.24,
  "text": "یعنی میتونه دربرخورد"
 },
 {
  "start": 800.24,
  "end": 801.26,
  "text": "با ماده"
 },
 {
  "start": 801.26,
  "end": 804.52,
  "text": "اون ماده را یونیزه بکنه"
 },
 {
  "start": 804.52,
  "end": 806.18,
  "text": "اتم ها را یونیزه بکنه"
 },
 {
  "start": 806.18,
  "end": 808.76,
  "text": "پرتاهای ذرعی هم"
 },
 {
  "start": 808.76,
  "end": 810.58,
  "text": "مثل آلفا و بیتا و اینا هم"
 },
 {
  "start": 810.58,
  "end": 811.7,
  "text": "یونیزان هستند"
 },
 {
  "start": 811.7,
  "end": 813.5,
  "text": "قدرت یونیزان"
 },
 {
  "start": 813.5,
  "end": 816.44,
  "text": "یونیزه کردن مواد را"
 },
 {
  "start": 816.44,
  "end": 817.9,
  "text": "دارند"
 },
 {
  "start": 817.9,
  "end": 820.18,
  "text": "خب که"
 },
 {
  "start": 820.18,
  "end": 841.88,
  "text": "حالا اینجا مشاهده می فرماید یا یک سری از خصوصیات این ذرات و تو این اثلایت گفته که حالا از نظر بار و جرم و قدرت نفوزشون که می تونه متفاوت باشد"
 },
 {
  "start": 841.88,
  "end": 856.11,
  "text": "که حالا انشالا من در جلسه بعدی راجع به واپاشی آلفا صحبت خواهم کرد"
 },
 {
  "start": 856.11,
  "end": 862.91,
  "text": "که یک ماده یک انصر چه خصوصیاتی داشته باشه"
 },
 {
  "start": 862.91,
  "end": 868.85,
  "text": "که واپاشی کننده آلفا باشه"
 },
 {
  "start": 868.85,
  "end": 879.89,
  "text": "و حالا موارد دیگه ارز کردم خدمت شما که مثلا هیچ وقت ایک انصر همراه با الفا بتا نمیده"
 },
 {
  "start": 879.89,
  "end": 895.25,
  "text": "یعنی یا فرض به فرماید یک انصر مثلا اگر عدد اطومی بالایی داشته باشد بیشتر هشتاد و سه اون به طریق الفا واپاشی میکنه"
 },
 {
  "start": 895.25,
  "end": 897.79,
  "text": "خب برای ایجاد واپاشی های دیگه"
 },
 {
  "start": 897.79,
  "end": 900.09,
  "text": "ما نیاز به شرایط"
 }
]