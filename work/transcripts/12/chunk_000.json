{
 "slug": "12",
 "chunk": 0,
 "chunk_start": 0.0,
 "chunk_end": 1140.8988,
 "duration_sec": 1140.8988,
 "elapsed_sec": 503.3,
 "language": "fa",
 "lang_prob": 1,
 "segments": [
  {
   "start": 2.13,
   "end": 28.0,
   "text": "بسم الله الرحمن الرحیم، در ادامه مباحث مربوط به درس فیزیک پزشکی، ما جلسه گذشته راجع به تشعشو، تعریف تشعشو و انواع تشعشوات صحبت کردیم"
  },
  {
   "start": 28.0,
   "end": 32.18,
   "text": "که حالا به دسته حتش هشهات زرهی به پرت های الکترومغناطیس"
  },
  {
   "start": 32.18,
   "end": 35.6,
   "text": "حالا تقسیم بندی می شد"
  },
  {
   "start": 35.6,
   "end": 42.26,
   "text": "و بعضی از این پرت های الکترومغناطیس یونیزان هستن"
  },
  {
   "start": 42.26,
   "end": 44.8,
   "text": "مثل ایکس و گاما بعضی هم غیری یونیزان"
  },
  {
   "start": 44.8,
   "end": 48.88,
   "text": "مثل واج رادیوی و نور مرعی و ماورای پنفش و غیره"
  },
  {
   "start": 48.88,
   "end": 54.6,
   "text": "که ما حالا تو این مبخص بیشتر به پرت های یونیزان می پردازیم"
  },
  {
   "start": 54.6,
   "end": 65.88,
   "text": "و پرتا یونیزان حالا راجب پرتو ایکس و طریق تولیدوش و اینا همکاران صحبت میکنند"
  },
  {
   "start": 65.88,
   "end": 73.72,
   "text": "منطقه ما من الان اینجا بیشتر راجب تشعشات زرعی صحبت میکنم"
  },
  {
   "start": 73.72,
   "end": 78.9,
   "text": "که این تشعشات زرعی چی هستند"
  },
  {
   "start": 78.9,
   "end": 80.3,
   "text": "به چی صورت تولید میشند"
  },
  {
   "start": 80.3,
   "end": 82.06,
   "text": "خصوصیاتشون چی هستش"
  },
  {
   "start": 82.06,
   "end": 87.12,
   "text": "و چه کاربورد های پزشکی دارند"
  },
  {
   "start": 87.12,
   "end": 97.32,
   "text": "خب همونطور که میدونید این تشاشات زره ای از مواد راژیو اکتیو ساته میشوند"
  },
  {
   "start": 97.32,
   "end": 107.04,
   "text": "که ما جلسه گذشته این قدار راجع به مواد راژیو اکتیو صحبت کردیم"
  },
  {
   "start": 107.04,
   "end": 111.16,
   "text": "که به دو دسته طبیعی و مصنوعی و موادی هستن"
  },
  {
   "start": 111.16,
   "end": 116.38,
   "text": "که به طور خود به خود از خودشون پرتوهای ساته میکنند"
  },
  {
   "start": 116.38,
   "end": 125.39,
   "text": "که اصلا گفتیم اصلا موقع واپاشی"
  },
  {
   "start": 125.39,
   "end": 127.79,
   "text": "اصلا جنس این اون سور عوض میشه"
  },
  {
   "start": 127.79,
   "end": 131.71,
   "text": "بعضی از خصوصی انواع پرتوها مثل آلفا، بیتا"
  },
  {
   "start": 131.71,
   "end": 135.61,
   "text": "پرتوهای زرهی مثل بیتای ماثبت، بیتای منفی"
  },
  {
   "start": 135.61,
   "end": 142.13,
   "text": "نوترون، پروتون، الکترون اینا تشاشات زرهی هستن"
  },
  {
   "start": 142.13,
   "end": 151.51,
   "text": "یک سری از خصوصیات شما مثل جرم شما و بارشون و قدرت نفوز اونها صحبت کردیم"
  },
  {
   "start": 151.51,
   "end": 164.09,
   "text": "و گفتیم به طور کلی مواد راژیو اکتیو به چند روش استحاله یا تدزیه میشن"
  },
  {
   "start": 164.09,
   "end": 177.33,
   "text": "که ما استحاله آلفا داریم، استحاله بتای منفی داریم، استحاله بتای مصبت داریم، الکترون کپچر داریم و همچنین واپاشی گاما داریم"
  },
  {
   "start": 177.33,
   "end": 185.64,
   "text": "ما میخوایم راجع به واپاشی آلفا صحبت بکنم"
  },
  {
   "start": 185.64,
   "end": 195.36,
   "text": "خب، راجع به خصوصیات ذره آلفا، حالا من گفتم که بارش حالا بار مصبت و جرمش هم زیاده"
  },
  {
   "start": 195.36,
   "end": 197.48,
   "text": "قدرت نفوزش کم هستش"
  },
  {
   "start": 197.48,
   "end": 199.44,
   "text": "مثلا در هوا در حد سانتیمتر"
  },
  {
   "start": 199.44,
   "end": 201.54,
   "text": "در باف در حد میکرون"
  },
  {
   "start": 201.54,
   "end": 203.7,
   "text": "یه برگ کاغذ میتونه اونو جذب کنه"
  },
  {
   "start": 203.7,
   "end": 205.62,
   "text": "و خصوصیات دیگه که قبلا گفته"
  },
  {
   "start": 205.62,
   "end": 206.94,
   "text": "مسیرش مستقیمه"
  },
  {
   "start": 206.94,
   "end": 210.08,
   "text": "تو میدانهای الکتریک و مغناطسی منحرف میشه"
  },
  {
   "start": 210.08,
   "end": 213.46,
   "text": "و یک تیف پیوستهی داره"
  },
  {
   "start": 213.46,
   "end": 214.82,
   "text": "یعنی مزرد میخوام"
  },
  {
   "start": 214.82,
   "end": 216.46,
   "text": "یک تیف خطی دارد"
  },
  {
   "start": 216.46,
   "end": 218.42,
   "text": "یعنی مونو انرژی هست"
  },
  {
   "start": 218.42,
   "end": 220.9,
   "text": "اینا خصوصیات زره آلفا بود"
  },
  {
   "start": 220.9,
   "end": 228.26,
   "text": "حالا یک ماده رادیو اکتیو چه خصوصیاتی داشته باشه که واپاشی کننده آلفا باشه"
  },
  {
   "start": 228.26,
   "end": 233.06,
   "text": "باید عدد اطومی آن بیشتر از هشتاد و سه باشد"
  },
  {
   "start": 233.06,
   "end": 237.78,
   "text": "یعنی یک انصر سنگینی باشد عدد اطومی زیاد باشه"
  },
  {
   "start": 237.78,
   "end": 243.68,
   "text": "وقتی عدد اطومی در اون انصر بیشتر از هشتاد و سه باشد"
  },
  {
   "start": 243.68,
   "end": 249.06,
   "text": "به طریقه آلفا تدزیه میشه واپاشی میشه"
  },
  {
   "start": 249.06,
   "end": 255.6,
   "text": "و توجیه هم این هستش که موقعی عدد اتمی زیاد باشه"
  },
  {
   "start": 255.6,
   "end": 259.4,
   "text": "انصار سنگین باشد تعداد پروتون ها یعنی زیاد هست"
  },
  {
   "start": 259.4,
   "end": 267.9,
   "text": "تعداد پروتون ها زیاد باشد این اون نیروی دافعه کلونی بین بارهای مصفت پروتون زیاد هست"
  },
  {
   "start": 267.9,
   "end": 274.44,
   "text": "و میتونه بر نیروی جازبه هستعی که اون نکلون ها را نگه احمیداره غلبه بکنه"
  },
  {
   "start": 274.44,
   "end": 285.0,
   "text": "و یک زره ای از حسطه اتم ساته بشه که دو تا پروتون داره و دو تا نوترون که با اون حسطه آلفا گفته میشه"
  },
  {
   "start": 285.0,
   "end": 300.6,
   "text": "که واکنش کلی هم این صورت هست که ایکس مادر تبدیل میشه به وای دختر که عدد اتمی دو واحد و عدد جرمی چار واحد کمتر دارد"
  },
  {
   "start": 300.6,
   "end": 304.7,
   "text": "به اضافه آلفا و به اضافه انرژی"
  },
  {
   "start": 304.7,
   "end": 310.46,
   "text": "پس میبینیم که یک انصور به انصور دیگری تبدیل میشه"
  },
  {
   "start": 310.46,
   "end": 313.32,
   "text": "این هم شما مشاهده میفرماهید"
  },
  {
   "start": 313.32,
   "end": 314.32,
   "text": "آلفا دیکی"
  },
  {
   "start": 314.32,
   "end": 318.52,
   "text": "خب اونواپاشی آلفا را معادله کلیش"
  },
  {
   "start": 318.52,
   "end": 320.68,
   "text": "ایکس و وای تبدیل میشه"
  },
  {
   "start": 320.68,
   "end": 323.26,
   "text": "که همونطور که تو اصلاحات قبلی هم توضیح دادن"
  },
  {
   "start": 323.26,
   "end": 327.5,
   "text": "به چه صورت عدد اطومی و عدد جرمیش تغییر میکند"
  },
  {
   "start": 327.5,
   "end": 330.06,
   "text": "مثلا اورانیوم 238"
  },
  {
   "start": 330.06,
   "end": 331.16,
   "text": "92"
  },
  {
   "start": 331.16,
   "end": 333.58,
   "text": "با باشی"
  },
  {
   "start": 333.58,
   "end": 335.76,
   "text": "الفا تبدیل میشه"
  },
  {
   "start": 335.76,
   "end": 337.8,
   "text": "به توریوم 234"
  },
  {
   "start": 337.8,
   "end": 339.12,
   "text": "90 به اضافه"
  },
  {
   "start": 339.12,
   "end": 340.7,
   "text": "اشهی الفا"
  },
  {
   "start": 340.7,
   "end": 343.52,
   "text": "یعنی اورانیومی که پروتونش"
  },
  {
   "start": 343.52,
   "end": 345.24,
   "text": "92 تا بوده و"
  },
  {
   "start": 345.24,
   "end": 347.9,
   "text": "146 تا هم نوترون داشته"
  },
  {
   "start": 347.9,
   "end": 351.76,
   "text": "دو تا پروتون و نوترونش که از دست"
  },
  {
   "start": 351.76,
   "end": 353.92,
   "text": "بده یعنی میشه 90 تا"
  },
  {
   "start": 353.92,
   "end": 356.2,
   "text": "پروتون"
  },
  {
   "start": 356.2,
   "end": 359.64,
   "text": "و 144 تا هم نوترون داره"
  },
  {
   "start": 359.64,
   "end": 361.66,
   "text": "با نیمه عمر 449"
  },
  {
   "start": 361.66,
   "end": 363.38,
   "text": "و در بتوانه 9 سال"
  },
  {
   "start": 363.38,
   "end": 366.58,
   "text": "تبدیل به توریوم 234 شده"
  },
  {
   "start": 366.58,
   "end": 368.04,
   "text": "مشاهده می فرمایید"
  },
  {
   "start": 368.04,
   "end": 369.32,
   "text": "با انرژی"
  },
  {
   "start": 369.32,
   "end": 371.34,
   "text": "4 آلفا 4 ممیز"
  },
  {
   "start": 371.34,
   "end": 373.26,
   "text": "1900 مفت که گفتیم"
  },
  {
   "start": 373.26,
   "end": 375.14,
   "text": "این انرژی ثابت هست"
  },
  {
   "start": 375.14,
   "end": 376.0,
   "text": "اون واپاشی"
  },
  {
   "start": 376.0,
   "end": 378.28,
   "text": "منو انرژی تک انرژی"
  },
  {
   "start": 378.28,
   "end": 381.38,
   "text": "و آلفا تیف خطی دارد"
  },
  {
   "start": 381.38,
   "end": 385.64,
   "text": "این از واپاشی"
  },
  {
   "start": 385.64,
   "end": 390.07,
   "text": "آلفا"
  },
  {
   "start": 390.07,
   "end": 395.23,
   "text": "خب حالا راجع به قدرت نفوزش و این هم که قبلا گفتم"
  },
  {
   "start": 395.23,
   "end": 398.39,
   "text": "یه برکاغذ میتونه پرتوی آلفا را چی کار بکنه؟"
  },
  {
   "start": 398.39,
   "end": 399.51,
   "text": "جذب کنه"
  },
  {
   "start": 399.51,
   "end": 404.39,
   "text": "منتها بتا خب قدرت نفوز بالاتری دارد"
  },
  {
   "start": 404.39,
   "end": 409.06,
   "text": "یا حالا گاما یا نوترون"
  },
  {
   "start": 409.06,
   "end": 413.62,
   "text": "خب راجع به پرتوی آلفا"
  },
  {
   "start": 413.62,
   "end": 424.9,
   "text": "گفتم که پرتوی آلفا قدرت نفوز کمی دارد"
  },
  {
   "start": 424.9,
   "end": 427.82,
   "text": "قدرت یونیزاسونه کمی دارد"
  },
  {
   "start": 427.82,
   "end": 432.45,
   "text": "و به بدن نمیتونه نفوز بکنه"
  },
  {
   "start": 432.45,
   "end": 435.79,
   "text": "طبقات شاخی پوست اونو میتونن جزب کنن"
  },
  {
   "start": 435.79,
   "end": 438.21,
   "text": "یه برگ کاغذ میتونه اونو جزب کنه"
  },
  {
   "start": 438.21,
   "end": 440.45,
   "text": "بردش درباف در حد میکرونه"
  },
  {
   "start": 440.45,
   "end": 447.68,
   "text": "ولی در این حال نسبت به بتا خطرناکتره"
  },
  {
   "start": 447.68,
   "end": 451.74,
   "text": "نسبت پرتا ایکس خطرناکتر هستش"
  },
  {
   "start": 451.74,
   "end": 453.74,
   "text": "چون قدرت یونیزاسونی داره"
  },
  {
   "start": 453.74,
   "end": 467.2,
   "text": "چرا پس کی میتونه در حقیقت به بدن آسی برسونه زمانی که ما پرتوگیری داخلی بکنیم"
  },
  {
   "start": 467.2,
   "end": 469.38,
   "text": "از راه خارجی که نمیتونه وارد بدن بشه"
  },
  {
   "start": 469.38,
   "end": 477.94,
   "text": "ولی مثلا ما از طریق نوشیدن یک آبی که حالا آلود مواد راژیو اکتیو وپاش کنه آلفا هست"
  },
  {
   "start": 477.94,
   "end": 479.06,
   "text": "وارد بدن بشه"
  },
  {
   "start": 479.06,
   "end": 481.06,
   "text": "یا از طریق مواد خوراکی"
  },
  {
   "start": 481.06,
   "end": 483.58,
   "text": "یا از طریق تزریقی"
  },
  {
   "start": 483.58,
   "end": 486.66,
   "text": "به طریقی وارده یا از طریق تنفس"
  },
  {
   "start": 486.66,
   "end": 488.6,
   "text": "گازرادان مثلا تنفس بشه"
  },
  {
   "start": 488.6,
   "end": 490.08,
   "text": "وارد بدن بشه"
  },
  {
   "start": 490.08,
   "end": 492.58,
   "text": "در این صورت هستش که"
  },
  {
   "start": 493.44,
   "end": 496.62,
   "text": "میتونه اون ما پرتوگیری داخلی بکنیم"
  },
  {
   "start": 496.62,
   "end": 498.94,
   "text": "توی بافتا مثلا توی تیروید"
  },
  {
   "start": 498.94,
   "end": 502.32,
   "text": "توی چه میدونم ریه توی کبد"
  },
  {
   "start": 502.32,
   "end": 504.3,
   "text": "روی استخان اونجا قرار بگیرن"
  },
  {
   "start": 504.3,
   "end": 508.32,
   "text": "و اونجا باف از داخل باف را مورد تابش قرار بدن"
  },
  {
   "start": 508.32,
   "end": 511.72,
   "text": "میشه آلودگی داخلی پرتوگیری داخلی"
  },
  {
   "start": 511.72,
   "end": 522.2,
   "text": "که میتونه آسیب های جبرام نپذیری به بافت های مختلف بدن وارد بکنه"
  },
  {
   "start": 522.2,
   "end": 538.12,
   "text": "این سلایدم که حالا قبل هم به نوی گفتیم"
  },
  {
   "start": 538.12,
   "end": 541.14,
   "text": "آلفا بر کاغذ میتونه جذبش بکنه"
  },
  {
   "start": 541.14,
   "end": 544.98,
   "text": "بیتا فلاسی گاماسور و نوترون بوتون"
  },
  {
   "start": 544.98,
   "end": 555.26,
   "text": "اما واپاشی دومین استحاله واپاشی بتای منفی هستش"
  },
  {
   "start": 555.26,
   "end": 560.36,
   "text": "بتای منفی یا نگاترون بهش میگن"
  },
  {
   "start": 560.36,
   "end": 563.38,
   "text": "بعدی که بار منفی داره"
  },
  {
   "start": 563.38,
   "end": 565.86,
   "text": "حالا سرعتش بیشتره"
  },
  {
   "start": 565.86,
   "end": 568.44,
   "text": "تو میدانه الکتریکی منحرف میشه"
  },
  {
   "start": 568.44,
   "end": 571.82,
   "text": "قدرت یونیزاسون نسبت به آلفا کمتر هستش"
  },
  {
   "start": 571.82,
   "end": 578.16,
   "text": "و مثلا بردش هم نسبت به آلفا"
  },
  {
   "start": 578.16,
   "end": 585.0,
   "text": "بردش بتا نسبت به آلفا در هوا در حد سانتیمتر تا متره"
  },
  {
   "start": 585.0,
   "end": 590.52,
