   "text": "جرم صفر و بدون بارو"
  },
  {
   "start": 1043.82,
   "end": 1045.12,
   "text": "به صورت نوع حرکت می کند"
  },
  {
   "start": 1045.12,
   "end": 1047.54,
   "text": "زراعت بنیادی فرعی هستند"
  },
  {
   "start": 1047.54,
   "end": 1048.6,
   "text": "که ما می توانیم اون را"
  },
  {
   "start": 1048.6,
   "end": 1050.6,
   "text": "در شرایطی توی آزمایشگاه"
  },
  {
   "start": 1050.6,
   "end": 1052.16,
   "text": "اون را دیتیکت بکنیم"
  },
  {
   "start": 1052.16,
   "end": 1054.2,
   "text": "همراه به تای منفی و به تای مصفت"
  },
  {
   "start": 1054.2,
   "end": 1057.56,
   "text": "و گفته که گاهی تابش"
  },
  {
   "start": 1057.56,
   "end": 1059.52,
   "text": "به تا خسته دختر"
  },
  {
   "start": 1059.52,
   "end": 1061.58,
   "text": "مستقید در حال پایی قرار نمی گیرد"
  },
  {
   "start": 1061.58,
   "end": 1063.54,
   "text": "و تابش گاما مثل اینجا"
  },
  {
   "start": 1063.54,
   "end": 1066.58,
   "text": "مثلا این به حالت پایهی میرسد"
  },
  {
   "start": 1066.58,
   "end": 1068.74,
   "text": "به حالت استیبل میرسد"
  },
  {
   "start": 1068.74,
   "end": 1074.07,
   "text": "جا هم مشاهده میفرمایید"
  },
  {
   "start": 1074.07,
   "end": 1075.13,
   "text": "دوباره یک"
  },
  {
   "start": 1075.13,
   "end": 1077.37,
   "text": "ردی اکتیو دیکی"
  },
  {
   "start": 1077.37,
   "end": 1078.77,
   "text": "که اون فرایند"
  },
  {
   "start": 1078.77,
   "end": 1080.99,
   "text": "اتم انستیبل"
  },
  {
   "start": 1080.99,
   "end": 1082.65,
   "text": "ناپایدار غیر پایدار"
  },
  {
   "start": 1082.65,
   "end": 1083.79,
   "text": "به طور خود خودی"
  },
  {
   "start": 1083.79,
   "end": 1085.01,
   "text": "به هر طور تابش میشه"
  },
  {
   "start": 1085.01,
   "end": 1088.35,
   "text": "و به یک انصور بابداشی به طای منفی"
  },
  {
   "start": 1088.35,
   "end": 1089.59,
   "text": "تبدیل میشه"
  },
  {
   "start": 1089.59,
   "end": 1091.81,
   "text": "انصور مادر پوتاسیوم چل"
  },
  {
   "start": 1091.81,
   "end": 1092.89,
   "text": "انستیبل"
  },
  {
   "start": 1092.89,
   "end": 1095.09,
   "text": "تبدیل میشه به دختر"
  },
  {
   "start": 1095.09,
   "end": 1099.71,
   "text": "هسته دختر کلسیوم چل استیبل"
  },
  {
   "start": 1099.71,
   "end": 1111.25,
   "text": "از واپاشی منفی"
  },
  {
   "start": 1111.25,
   "end": 1115.95,
   "text": "که انشاءالله در جلسه آینده"
  },
  {
   "start": 1115.95,
   "end": 1120.49,
   "text": "من راجع به واپاشی بتای مصبت"
  },
  {
   "start": 1120.49,
   "end": 1124.81,
   "text": "یا پوزیترون صحبت میکنم"
  },
  {
   "start": 1124.81,
   "end": 1130.01,
   "text": "ممنون از حسن توجه شما"
  }
 ]
}