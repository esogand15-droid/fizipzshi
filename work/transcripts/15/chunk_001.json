 "language": "fa",
 "lang_prob": 1,
 "segments": [
  {
   "start": 1200.0,
   "end": 1226.79,
   "text": "بچه ها شما یک خاتثباتی مشاهده میفرمایید. اینجا روی دنده یک خاتثباتی مشاهده میفرمایید. این محره که حالا مدودا تی دوازده، مورای دوازده هام سینه ای اینجا یک خاتثباتی مشاهده میفرمایید."
  },
  {
   "start": 1226.79,
   "end": 1230.57,
   "text": "که اینا حالا قابل بررسی هستش"
  },
  {
   "start": 1230.57,
   "end": 1237.32,
   "text": "قسمت راست بیمار بله اینجا هم مشاهده می فرمایید"
  },
  {
   "start": 1237.32,
   "end": 1239.74,
   "text": "خیلی خوب"
  },
  {
   "start": 1239.74,
   "end": 1245.69,
   "text": "از ساز تشخیصیست بچه ها به این صورته که عرض کردن"
  },
  {
   "start": 1245.69,
   "end": 1255.0,
   "text": "این هم یک اسکن کلیه هست که ما حالا هم برای آناتومی کلیه"
  },
  {
   "start": 1255.0,
   "end": 1260.86,
   "text": "و برای هم برای فیزیولوژی کلیه ما می توانیم اسکن بگیریم"
  },
  {
   "start": 1260.86,
   "end": 1264.3,
   "text": "بحث آناتومی کلیه بچه ها مثلا اون تکنیسیومه"
  },
  {
   "start": 1264.3,
   "end": 1265.7,
   "text": "تبدیل میشه با"
  },
  {
   "start": 1265.7,
   "end": 1267.88,
   "text": "لیبل میشه با دی ام ایس ای"
  },
  {
   "start": 1267.88,
   "end": 1269.98,
   "text": "که ما میتونیم آناتومی کلیه را ببینیم"
  },
  {
   "start": 1269.98,
   "end": 1271.96,
   "text": "و همون عمل کرد یا فیزیولوژی"
  },
  {
   "start": 1271.96,
   "end": 1273.5,
   "text": "کلیه فانکشن کلیه را"
  },
  {
   "start": 1273.5,
   "end": 1275.92,
   "text": "با حالا که ببینیم کلیه"
  },
  {
   "start": 1275.92,
   "end": 1277.94,
   "text": "وضعیت هارا ترشو کلیه"
  },
  {
   "start": 1277.94,
   "end": 1280.38,
   "text": "چی طور روح عمل کرد کلیه به چی صورت هستش"
  },
  {
   "start": 1280.38,
   "end": 1281.64,
   "text": "با"
  },
  {
   "start": 1281.64,
   "end": 1285.28,
   "text": "با اون حالا سیستم"
  },
  {
   "start": 1285.28,
   "end": 1287.28,
   "text": "پلویکالیس شما بارده دیگر"
  },
  {
   "start": 1287.28,
   "end": 1289.72,
   "text": "با اون تکنیسیوم"
  },
  {
   "start": 1289.72,
   "end": 1291.28,
   "text": "با دی تی پی ای"
  },
  {
   "start": 1291.28,
   "end": 1302.8,
   "text": "لیبل میشه اومده شیمیای DTPA و ما میتونیم کلیه ها را هم از لحاظ آناتمی و هم از لحاظ فیزیولوژی چه کار بکنیم بررسی بکنیم"
  },
  {
   "start": 1302.8,
   "end": 1321.84,
   "text": "خب این هم بچه ها یک اسکن قلب هستش که اسکن قلب حالا توی دو مرحله انجام میشه بچه ها"
  },
  {
   "start": 1321.84,
   "end": 1331.16,
   "text": "حالا شما میدونید که برای بررسی عروغ کرونری و گرفتگی اون عروغ"
  },
  {
   "start": 1331.16,
   "end": 1334.42,
   "text": "ما روش های مختلف تشخیصی داریم"
  },
  {
   "start": 1334.42,
   "end": 1338.74,
   "text": "یکی بحث حالا آنجیوگرافی کانونشنال هستش"
  },
  {
   "start": 1338.74,
   "end": 1341.52,
   "text": "که تهاجمی از طریق شریان فامورال"
  },
  {
   "start": 1341.52,
   "end": 1347.48,
   "text": "کاتتر میفرستن و به سمت قلب"
  },
  {
   "start": 1347.48,
   "end": 1350.68,
   "text": "و از اون طرف داروی ماده حاجب"
  },
  {
   "start": 1350.68,
   "end": 1352.52,
   "text": "نه راژیو اکتیو مواده حاجب"
  },
  {
   "start": 1352.52,
   "end": 1354.98,
   "text": "مواده کنترازا تزریق میکنند و تصویم میکنند"
  },
  {
   "start": 1354.98,
   "end": 1357.84,
   "text": "یه مورد ستی آنژیو هست"
  },
  {
   "start": 1357.84,
   "end": 1360.68,
   "text": "که ما حالا فعلا اینجا"
  },
  {
   "start": 1360.68,
   "end": 1362.48,
   "text": "رونا بحث نمی کنیم"
  },
  {
   "start": 1362.48,
   "end": 1365.26,
   "text": "که از طریق ورید مواده حاجب تزریق میکنند"
  },
  {
   "start": 1365.26,
   "end": 1366.5,
   "text": "و تصویم میکنند"
  },
  {
   "start": 1366.5,
   "end": 1368.62,
   "text": "منطور پزشکی هسته ای بچه ها"
  },
  {
   "start": 1368.62,
   "end": 1371.98,
   "text": "یک روی شیست که بستخواده از مواد راژیو اکتیو"
  },
  {
   "start": 1371.98,
   "end": 1375.44,
   "text": "از طریق وریدی تزریق میشه به بدن بیمار"
  },
  {
   "start": 1375.44,
   "end": 1378.8,
   "text": "و اسکن قلب میگنند"
  },
  {
   "start": 1378.8,
   "end": 1381.98,
   "text": "اسکن قلب بچه ها به صورت دو مرحله است"
  },
  {
   "start": 1381.98,
   "end": 1387.02,
   "text": "مرحله رست و مرحله استرست"
  },
  {
   "start": 1387.02,
   "end": 1392.75,
   "text": "مرحله رست یک اماده راژیو دارو"
  },
  {
   "start": 1392.75,
   "end": 1397.89,
   "text": "با MIBI لیبل میشه"
  },
  {
   "start": 1397.89,
   "end": 1401.03,
   "text": "و به بیمار تزریق میشه"
  },
  {
   "start": 1401.03,
   "end": 1405.31,
   "text": "و حالا بعد از اون"
  },
  {
   "start": 1405.31,
   "end": 1409.57,
   "text": "مریض برده به سیله اون دستگاه ها"
  },
  {
   "start": 1409.57,
   "end": 1411.75,
   "text": "که مریض زیر دستگاه خوابونده میشه"
  },
  {
   "start": 1411.75,
   "end": 1417.35,
   "text": "و از بیمار اسکن گرفته میشه"
  },
  {
   "start": 1417.35,
   "end": 1423.8,
   "text": "این مرحله مرحله رست هستش"
  },
  {
   "start": 1423.8,
   "end": 1426.64,
   "text": "یک مرحله هم داری مرحله استرست"
  },
  {
   "start": 1426.64,
   "end": 1429.88,
   "text": "مرحله استرست بچه ها اون مرحله هست که میخوان ببینین"
  },
  {
   "start": 1429.88,
   "end": 1438.1,
   "text": "در زمانی که قلب حد اکثر اون بازدهی خودشو داره"
  },
  {
   "start": 1438.1,
   "end": 1440.2,
   "text": "حد اکثر فعالیت خودشو داره"
  },
  {
   "start": 1440.2,
   "end": 1442.66,
   "text": "اون راژیو داره و به امار تذریق میکنن"
  },
  {
   "start": 1442.66,
   "end": 1446.8,
   "text": "که در این صورت اگه گرفتگی چیز باشه باید خودشو بهتر نشون میده"
  },
  {
   "start": 1446.8,
   "end": 1455.85,
   "text": "که امریزو در حال تست ورزش کردن"
  },
  {
   "start": 1455.85,
   "end": 1462.23,
   "text": "در هنگام تست برزش زمانی که اون برونده قلبش به حد اکثر مقدار لازم برستد"
  },
  {
   "start": 1462.23,
   "end": 1465.93,
   "text": "در همه راژیو دارو بیمار تذریق میکنند"
  },
  {
   "start": 1465.93,
   "end": 1474.63,
   "text": "و بعد از اون بعد از تذریق حالا 45 دقیقه بعد از تذریق بیمار رو زیر دستگاه میبرند"
  },
  {
   "start": 1474.63,
   "end": 1477.25,
   "text": "و تصویر میگیرند"
  },
  {
   "start": 1477.25,
   "end": 1481.13,
   "text": "خب این دو مرحله است"
  },
  {
   "start": 1481.13,
   "end": 1483.59,
   "text": "مرحله رس و مرحله استرس"
  },
  {
   "start": 1483.59,
   "end": 1490.89,
   "text": "من استرس بچه بخاطر اونه که بخوان اون اگه گرفتگی کچیکی هم که باشه توی بدن توی اون روکرونی داره"
  },
  {
   "start": 1490.89,
   "end": 1495.41,
   "text": "اینگام اگه فعالیت قلب زیاد بشه خوب خودشو بهتر نشون میده"
  },
  {
   "start": 1495.41,
   "end": 1504.39,
   "text": "که حالا قبل از این که در حقیقه از مریض اسکن بگیرن"
  },
  {
   "start": 1504.39,
   "end": 1508.83,
   "text": "الان با دستگاه ایسپیکت ستی یا گاما کامرا یا دستگاه دی باشه"
  },
  {
   "start": 1508.83,
   "end": 1512.63,
   "text": "یک چیز چرب به مریض بینن بخوره"
  },
  {
   "start": 1512.63,
   "end": 1513.07,
   "text": "مثلا"
  },
  {
   "start": 1513.07,
   "end": 1516.75,
   "text": "کره شیر پرچرب چیزی به مریض میدن"
  },
  {
   "start": 1516.75,
   "end": 1518.63,
   "text": "بخوره این به خاطر تخلیه"
  },
  {
   "start": 1518.63,
   "end": 1520.59,
   "text": "اون کبدو کیسه"
  },
  {
   "start": 1520.59,
   "end": 1522.45,
   "text": "سفرا از چربی هست که به عنوان"
  },
  {
   "start": 1522.45,
   "end": 1524.41,
   "text": "تصویر مزاهم نشه"
  },
  {
   "start": 1524.41,
   "end": 1526.45,
   "text": "که بخواید با یک حتی اثبات زیادی ما"
  },
  {
   "start": 1526.45,
   "end": 1528.87,
   "text": "اون ناهیه را ببینیم در اوز قلبش"
  },
  {
   "start": 1528.87,
   "end": 1530.47,
   "text": "مثلا که بغل هستش"
  },
  {
   "start": 1530.47,
   "end": 1532.05,
   "text": "در مجاورون هستش ما نتونیم"
  },
  {
   "start": 1532.05,
   "end": 1534.29,
   "text": "با کیفیت خوب ببینیم اینیم که میخواین"
  },
  {
   "start": 1534.29,
   "end": 1536.07,
   "text": "اون کبدو کیسه سفرا را از"
  },
  {
   "start": 1536.07,
   "end": 1538.03,
   "text": "چربی که"
  },
  {
   "start": 1538.03,
   "end": 1540.35,
   "text": "از تجمعه چربی و اونجا"
  },
  {
   "start": 1540.35,
   "end": 1542.45,
   "text": "حالا مواد رادی اکتیف چه کار بکنن"
  },
  {
   "start": 1542.45,
   "end": 1543.71,
   "text": "تخلیه بکنن"
  },
  {
   "start": 1543.71,
   "end": 1545.39,
   "text": "علتش این هستش"
  },
  {
   "start": 1545.39,
   "end": 1547.99,
   "text": "که تصویر پزشکی هسته"
  },
  {
   "start": 1547.99,
   "end": 1550.17,
   "text": "به این صورت هستش که شما اینجا"
  },
  {
   "start": 1550.17,
   "end": 1551.49,
   "text": "مشاهده می فرمایید"
  },
  {
   "start": 1551.49,
   "end": 1553.91,
   "text": "که مثلا اینجا فرمایید"
  },
  {
   "start": 1553.91,
   "end": 1556.03,
   "text": "ای گرفتگی چیزی خب طبیعتا"
  },
  {
   "start": 1556.03,
   "end": 1558.35,
   "text": "اون مواد رادی اکتیفی که اونجا تجمعه پیدا میکنه"
  },
  {
   "start": 1558.35,
   "end": 1559.85,
   "text": "اگه جای گرفتگی باشه"
  },
  {
   "start": 1559.85,
   "end": 1561.91,
   "text": "به اونجا نمیتونند برند دیگه"
  },
  {
   "start": 1561.91,
   "end": 1566.01,
   "text": "وقتی نرن مادرات اکتیب اونجا نشت پیدا نکنند یعنی اونجا گرفتگی هست"
  },
  {
   "start": 1566.01,
   "end": 1570.25,
   "text": "یعنی ما هیچگونه پرتوی گامایی نداریم یا هیچگونه پارس الکتریکی نداریم"
  },
  {
   "start": 1570.25,
   "end": 1572.37,
   "text": "یعنی هیچگونه تصویری نمیتونیم بدیم"
  },
  {
   "start": 1572.37,
   "end": 1582.68,
   "text": "مثلا شما بعضی مشاهده میفرمایید که حالا این ناهیه مثلا این قسمت دیواره انفریور قلب"
  },
  {
   "start": 1582.68,
   "end": 1585.06,
   "text": "مثلا دیفکت نقص داره"
  },
  {
   "start": 1585.06,
   "end": 1593.6,
   "text": "تو بعضی از تصاویر مثلا این ردیف های پایین میبینید که شما اون دایره کامل نیست"
  },
  {
   "start": 1593.6,
   "end": 1597.7,
   "text": "اگه به این تصاویر بالایی مهم به این صورت بودن"
  },
  {
   "start": 1597.7,
   "end": 1601.68,
   "text": "نشان برای این بود که بلاخره یه نقص اینجا وجود داره"
  },
  {
   "start": 1601.68,
   "end": 1608.4,
   "text": "و مثلا ردیف های اول و دوم شما مشاهده بفرمایید که کامل هستش اینو"
  },
  {
   "start": 1608.4,
   "end": 1614.32,
   "text": "اگه این نواهی مثلا فرض فرمایید نقصی چیزی وجود داشته باشه"
  },
  {
   "start": 1614.32,
   "end": 1622.12,
   "text": "این حالا شکل ها به صورت کامل تشکیل نمی شدند"
  },
  {
   "start": 1622.12,
   "end": 1623.88,
   "text": "چون راژیو دارو اینجا نمی رفت"
  },
  {
   "start": 1623.88,
   "end": 1626.6,
   "text": "چون پرتوی گامایی ساطه نمی شد و موارد دیگه"
  },
  {
   "start": 1626.6,
   "end": 1628.98,
   "text": "که حالا تشخیصش بحث تشخیص اینجا می ره"
  },
  {
   "start": 1628.98,
   "end": 1631.8,
   "text": "با متقصص پزشکی هستهی"
  },
  {
   "start": 1631.8,
   "end": 1635.7,
   "text": "این تصاویر خانده می شه"
  },
  {
   "start": 1635.7,
   "end": 1639.28,
   "text": "تفسیر می شه و در نهایت به سلی پزشک متقصص قلب"
  },
  {
   "start": 1639.28,
   "end": 1641.56,
   "text": "و فقط از قلب و اروغ چه می شه"
  },
  {
   "start": 1641.56,
   "end": 1643.16,
   "text": "تشخیص داده می شه"
  },
  {
   "start": 1643.16,
   "end": 1657.94,
   "text": "خیلی خب پس به طور کلی بچه ها پزشکی خسته ای اون یک نوع تصویرگیری است"
  },
  {
   "start": 1657.94,
   "end": 1664.56,
   "text": "از نواهی مختلف بدن با اون تزریق مواد راژی اکتیف نشر مواد راژی اکتیف"
  },
  {
   "start": 1664.56,
   "end": 1672.49,
   "text": "اون دیتکت کردن اون تشاشات ناشید از مواد راژی اکتیف"
  },
  {
   "start": 1672.49,
   "end": 1675.17,
   "text": "و در نهایت تولید پالس الکتریکی"
  },
  {
   "start": 1675.17,
   "end": 1676.47,
   "text": "سیگنال الکتریکی"
  },
  {
   "start": 1676.47,
   "end": 1678.97,
   "text": "و تشکیل تصویر"
  },
  {
   "start": 1678.97,
   "end": 1680.85,
   "text": "و تفسیر اون"
  },
  {
   "start": 1680.85,
   "end": 1684.14,
   "text": "تصویر"
  },
  {
   "start": 1684.14,
   "end": 1686.7,
   "text": "خب اساسش هم که گفتم"
  },
  {
   "start": 1686.7,
   "end": 1688.84,
   "text": "خدمتش هم و بر اساس اون که حالا"
  },
  {
   "start": 1688.84,
   "end": 1690.26,
   "text": "با توجه به اون"
  },
  {
   "start": 1690.26,
   "end": 1692.58,
   "text": "که در"
  },
  {
   "start": 1692.58,
   "end": 1695.5,
   "text": "بافتهای اندامهای"
  },
  {
   "start": 1695.5,
   "end": 1696.56,
   "text": "که ما یه نقصی"
  },
  {
   "start": 1696.56,
   "end": 1699.26,
   "text": "یک بیماری چیزی داشته باشیم"
  },
  {
   "start": 1699.26,
   "end": 1701.24,
   "text": "خب ممکنه"
  },
  {
   "start": 1701.24,
   "end": 1703.2,
   "text": "بعضا این مواد رای اکتیب"
  },
  {
   "start": 1703.2,
   "end": 1705.78,
   "text": "اونجا تجمع پیدا نکنن"
  },
  {
   "start": 1705.78,
   "end": 1707.32,
   "text": "نرن مثل مثلا یه گرفتگی"
  },
  {
   "start": 1707.32,
   "end": 1709.12,
   "text": "یه گروه یا چیزی داشته باشیم"
  },
  {
   "start": 1709.12,
   "end": 1711.74,
   "text": "یا ممکن هستش که اصلا"
  },
  {
   "start": 1711.74,
   "end": 1713.98,
   "text": "میتابولیسم زیاد باشه"
  },
  {
   "start": 1713.98,
   "end": 1715.72,
   "text": "سرطانی باشن برن اونجا تجمع"
  },
  {
   "start": 1715.72,
   "end": 1717.56,
   "text": "بکنن که اونجا هم"
  },
  {
   "start": 1717.56,
   "end": 1719.14,
   "text": "حالا دواره میشه"
  },
  {
   "start": 1719.14,
   "end": 1721.5,
   "text": "هات اثبات میشه پس این بر اساس"
  },
  {
   "start": 1721.5,
   "end": 1723.8,
   "text": "اون میزان نشت مواد"
  },
  {
   "start": 1723.8,
   "end": 1725.4,
   "text": "رادی اکتیف داخل بدن"
  },
  {
   "start": 1725.4,
   "end": 1727.24,
   "text": "ما میتونیم به"
  },
  {
   "start": 1727.24,
   "end": 1729.54,
   "text": "تشخیص"
  },
  {
   "start": 1729.54,
   "end": 1731.8,
   "text": "نوع خاص از بیماری"
  },
  {
   "start": 1731.8,
   "end": 1735.13,
   "text": "برسیم"
  },
  {
   "start": 1735.13,
   "end": 1739.55,
   "text": "خب که برای"
  },
  {
   "start": 1739.55,
   "end": 1742.91,
   "text": "اسکنهای مختلف"
  },
  {
   "start": 1742.91,
   "end": 1745.17,
   "text": "حالا توی پزشکی هستهی"
  },
  {
   "start": 1745.17,
   "end": 1747.43,
   "text": "امدتا از تکنیسیوم"
  },
  {
   "start": 1747.43,
   "end": 1748.47,
   "text": "استفاده میشه"
  },
  {
   "start": 1748.47,
   "end": 1751.23,
   "text": "و این تکنیسیوم بسته به ناهی آناتومی"
  },
  {
   "start": 1751.23,
   "end": 1753.15,
   "text": "که مورد نظر از کجا ناهی"
  },
  {
   "start": 1753.15,
   "end": 1754.33,
   "text": "تصفیم میخوام بگیریم"
  },
  {
   "start": 1754.33,
   "end": 1756.37,
   "text": "با مواد مختلف شیمیایی"
  },
  {
   "start": 1756.37,
   "end": 1757.73,
   "text": "لیبل میشود"
  },
  {
   "start": 1757.73,
   "end": 1759.03,
   "text": "که گفتیم مثلا"
  },
  {
   "start": 1759.03,
   "end": 1761.31,
   "text": "استخان امدی پی"
  },
  {
   "start": 1761.31,
   "end": 1763.39,
   "text": "قلب با ام آی بی آی"
  },
  {
   "start": 1763.39,
   "end": 1766.07,
   "text": "و من چه می دونم"
  },
  {
   "start": 1766.07,
   "end": 1769.29,
   "text": "قلیه حالا بسته که به آناتومی و فیزیولوشی"
  },
  {
   "start": 1769.29,
   "end": 1770.89,
   "text": "دی تی پی ای و ام آی بی"
  },
  {
   "start": 1770.89,
   "end": 1772.85,
   "text": "دی تی پی و دی ام ای س آ"
  },
  {
   "start": 1772.85,
   "end": 1773.63,
   "text": "ای"
  },
  {
   "start": 1773.63,
   "end": 1776.69,
   "text": "که لیبل می شن"
  },
  {
   "start": 1776.69,
   "end": 1779.67,
   "text": "و تصفیر می گیره"
  },
  {
   "start": 1779.67,
   "end": 1780.43,
   "text": "خیلی خوب"
  },
  {
   "start": 1780.43,
   "end": 1782.23,
   "text": "این بچه ها"
  },
  {
   "start": 1782.23,
   "end": 1785.27,
   "text": "خلاصه ای بود"
  },
  {
   "start": 1785.27,
   "end": 1786.03,
   "text": "از"
  },
  {
   "start": 1786.03,
   "end": 1787.35,
   "text": "بحث"
  },
  {
   "start": 1787.35,
   "end": 1790.97,
   "text": "پزشکی هسته ای و"
  },
  {
   "start": 1790.97,
   "end": 1800.81,
   "text": "کاربورد راژیو دارو در پزشکی هستهی و تصویرگیری برای بفتای مختلف"
  },
  {
   "start": 1800.81,
   "end": 1806.31,
   "text": "که انشاءالله جلسه آینده من راجع به راژیو تراپی"
  },
  {
   "start": 1806.31,
   "end": 1820.43,
   "text": "یا کاربورد یا پرت و درمانی یا کاربورد درمانی این پرتوها دوزی میدم خدمت شما"
  },
  {
   "start": 1820.43,
   "end": 1833.55,
   "text": "خب ممنون از حسن توجه و صبر و حسنه شما خدا نگهدار"
  }
 ]
}