{
 "slug": "02",
 "chunk": 1,
 "chunk_start": 1200.0,
 "chunk_end": 1357.567415,
 "duration_sec": 157.56741499999998,
 "elapsed_sec": 95.4,
 "language": "fa",
 "lang_prob": 1,
 "segments": [
  {
   "start": 1200.0,
   "end": 1225.04,
   "text": "در واقع چی میشه؟ یه تشخیص بهتری، به تشخیص بهتری میرسیم. پس و این که یه نکته دیگه هم که هست، تی ای تایم آف ایکو هستش، یعنی زمان پالس، یعنی اون میشه فاصله زمانی پالس رف تا وسط ایکو، یعنی وسط سیگنالی که میگیریم، سیگنال قویی که میگیریم میشه تایم آف ایکو."
  },
  {
   "start": 1225.04,
   "end": 1227.64,
   "text": "تی آر تایم آف ریپیتیشن هستش"
  },
  {
   "start": 1227.64,
   "end": 1232.08,
   "text": "یعنی فاصله زمانی دو تا پالسه که"
  },
  {
   "start": 1232.08,
   "end": 1235.3,
   "text": "یک ثانی که دارن تکرار میشن در واقع"
  },
  {
   "start": 1235.3,
   "end": 1239.78,
   "text": "به خاطر همین در واقع تی آر میشه تایم آف ریپیتیشن"
  },
  {
   "start": 1239.78,
   "end": 1244.12,
   "text": "و نگاه کنید تو امارای فقط یک پالس آر اف نمیفرستیم"
  },
  {
   "start": 1244.12,
   "end": 1248.8,
   "text": "با یک بار پالس آر اف برستادن سیگنال قوی به ما نمیده"
  },
  {
   "start": 1248.8,
   "end": 1250.82,
   "text": "و ما تصویر خوبی نخواهیم داشت"
  },
  {
   "start": 1250.82,
   "end": 1253.46,
   "text": "باید چندین بار پالس آر اف بفرستیم"
  },
  {
   "start": 1253.46,
   "end": 1255.52,
   "text": "قد کنیم تشدید صورت"
  },
  {
   "start": 1255.52,
   "end": 1257.34,
   "text": "بگیره تا به ما یه تصویر"
  },
  {
   "start": 1257.34,
   "end": 1259.28,
   "text": "خوبی بده یعنی سیگنال خیلی خوبی"
  },
  {
   "start": 1259.28,
   "end": 1261.64,
   "text": "داشته باشیم پس تر امارای"
  },
  {
   "start": 1261.64,
   "end": 1263.66,
   "text": "سیگنالی که میگیریم یه تیفه"
  },
  {
   "start": 1263.66,
   "end": 1265.1,
   "text": "بعضی از سیگنال ها رو"
  },
  {
   "start": 1265.1,
   "end": 1267.4,
   "text": "ضعیف میکنیم یه تصویرمون"
  },
  {
   "start": 1267.4,
   "end": 1269.14,
   "text": "مثلا تیتو بشه"
  },
  {
   "start": 1269.14,
   "end": 1271.18,
   "text": "مثلا اگه تیوان رو ضعیف کردیم میشه تیتو"
  },
  {
   "start": 1271.18,
   "end": 1273.68,
   "text": "تیتو رو ضعیف کردیم کنیم میشه تیوان"
  },
  {
   "start": 1273.68,
   "end": 1275.58,
   "text": "اگه دوتا معلفه ی تیوان تیتو"
  },
  {
   "start": 1275.58,
   "end": 1277.62,
   "text": "زعیف کنیم میشه پروتون دنسیتی"
  },
  {
   "start": 1277.62,
   "end": 1279.7,
   "text": "خب اینجا داره نشون"
  },
  {
   "start": 1279.7,
   "end": 1281.24,
   "text": "میده که"
  },
  {
   "start": 1281.24,
   "end": 1283.56,
   "text": "وقتی که مریض در یک میدان"
  },
  {
   "start": 1283.56,
   "end": 1285.68,
   "text": "مناسی باید بخوابه"
  },
  {
   "start": 1285.68,
   "end": 1287.46,
   "text": "و آر اف بفرسنیم"
  },
  {
   "start": 1287.46,
   "end": 1289.9,
   "text": "قد کنیم و سیگنال بگیریم"
  },
  {
   "start": 1289.9,
   "end": 1291.4,
   "text": "وقت از این که حالا"
  },
  {
   "start": 1291.4,
   "end": 1293.4,
   "text": "تشدید صورت گرفت پروتون هایی"
  },
  {
   "start": 1293.4,
   "end": 1295.5,
   "text": "به ما سیگنال میدن که تشدید صورت"
  },
  {
   "start": 1295.5,
   "end": 1297.18,
   "text": "گرفته باشه در اون پروتون"
  },
  {
   "start": 1297.18,
   "end": 1299.62,
   "text": "بعد به ما سیگنال میده و سیگنال قوی"
  },
  {
   "start": 1299.62,
   "end": 1301.2,
   "text": "هم باید بگیریم. مثلا این سیگنال"
  },
  {
   "start": 1301.2,
   "end": 1303.32,
   "text": "ضعیفه خوب. با افزایش زمان"
  },
  {
   "start": 1303.32,
   "end": 1305.28,
   "text": "داره چی؟ کمتر میشه"
  },
  {
   "start": 1305.28,
   "end": 1307.16,
   "text": "و این چیه؟ این معمولا"
  },
  {
   "start": 1307.16,
   "end": 1308.5,
   "text": "بعد از پالس آر اف"
  },
  {
   "start": 1308.5,
   "end": 1310.56,
   "text": "180 درجه یک سیگنال"
  },
  {
   "start": 1310.56,
   "end": 1311.66,
   "text": "ایکو بهش میگن"
  },
  {
   "start": 1311.66,
   "end": 1314.82,
   "text": "داریم که در واقع سیگنال"
  },
  {
   "start": 1314.82,
   "end": 1316.78,
   "text": "قوی هستش. این سیگنال"
  },
  {
   "start": 1316.78,
   "end": 1319.14,
   "text": "بعد از پالس آر اف 90 درجه هستش"
  },
  {
   "start": 1319.14,
   "end": 1320.9,
   "text": "که معمولا 90 و 180"
  },
  {
   "start": 1320.9,
   "end": 1322.46,
   "text": "میفرستن. یعنی"
  },
  {
   "start": 1322.46,
   "end": 1324.34,
   "text": "یه ترتیبی داره. خوب"
  },
  {
   "start": 1324.34,
   "end": 1326.22,
   "text": "بعد از اینکه سیگنال گرفتیم"
  },
  {
   "start": 1326.22,
   "end": 1329.28,
   "text": "در واقعه چیه؟ تصویرمون آنالوگه"
  },
  {
   "start": 1329.28,
   "end": 1332.38,
   "text": "آنالوگ رو به تبدیل میکنیم به دیژیتال"
  },
  {
   "start": 1332.38,
   "end": 1335.08,
   "text": "آنالوگ تو دیژیتال کانورشن حالا نوشته"
  },
  {
   "start": 1335.08,
   "end": 1337.2,
   "text": "یعنی آنالوگ رو تبدیل میکنیم به دیژیتال"
  },
  {
   "start": 1337.2,
   "end": 1339.4,
   "text": "و توسط سیستم کامپیوتر"
  },
  {
   "start": 1339.4,
   "end": 1341.72,
   "text": "یک فرمول ریاضی انجام میدن"
  },
  {
   "start": 1341.72,
   "end": 1344.44,
   "text": "ترانسفوریر ترانسفورمیشن انجام میدن"
  },
  {
   "start": 1344.44,
   "end": 1346.82,
   "text": "و در نهایت ما تصویرمون یا تیوانه"
  },
  {
   "start": 1346.82,
   "end": 1349.36,
   "text": "یا تیتوه یا پروتون دنسیتی"
  },
  {
   "start": 1349.36,
   "end": 1353.9,
   "text": "که من گفتم که این سلاید قبلی در موردش صحبت کردم"
  },
  {
   "start": 1353.9,
   "end": 1356.76,
   "text": "خسته نباشین خدا نگهدار"
  }
 ]
}