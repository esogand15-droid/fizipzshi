  "start": 502.16,
  "end": 504.32,
  "text": "حالا به صورت که اینجا به صورت"
 },
 {
  "start": 504.32,
  "end": 506.88,
  "text": "دامنه این را میبینید"
 },
 {
  "start": 506.88,
  "end": 508.4,
  "text": "اینجا به صورت نقاط روشن"
 },
 {
  "start": 508.4,
  "end": 509.08,
  "text": "و تاریک"
 },
 {
  "start": 509.08,
  "end": 511.08,
  "text": "سونگرافی معمولی"
 },
 {
  "start": 511.08,
  "end": 513.06,
  "text": "نمیدونم سونگرافی"
 },
 {
  "start": 513.06,
  "end": 518.19,
  "text": "برای بررسی جنین"
 },
 {
  "start": 518.19,
  "end": 519.55,
  "text": "جنسیت جنین"
 },
 {
  "start": 519.55,
  "end": 521.93,
  "text": "رشد جنین"
 },
 {
  "start": 521.93,
  "end": 524.15,
  "text": "بررسی سینه"
 },
 {
  "start": 524.15,
  "end": 530.53,
  "text": "یا برست خانم ها کلیه کبد مثلا اینا همه توی بیمود هستش بچه ها روش بیمود هستش"
 },
 {
  "start": 530.53,
  "end": 533.79,
  "text": "یک روش حالا تصویر دوبودی هستش"
 },
 {
  "start": 533.79,
  "end": 538.89,
  "text": "که اون باستاب ها که توی ایمود دیدیم اینا به صورت نقاط روشن و تاریک مشخص میشه"
 },
 {
  "start": 538.89,
  "end": 547.93,
  "text": "که حالا تمام مراقبت های دوره بارداری مثلا جفت سر راهی سن جنین از روی قدر استخان آهیانه بچه ها نلگن"
 },
 {
  "start": 547.93,
  "end": 550.41,
  "text": "از روقات رستخان آهیانه"
 },
 {
  "start": 550.41,
  "end": 552.53,
  "text": "تغذیه یا بدهی تغذیه"
 },
 {
  "start": 552.53,
  "end": 554.09,
  "text": "جنین یا همون رشد جنین"
 },
 {
  "start": 554.09,
  "end": 556.03,
  "text": "جنسیت جنین برسیه برس"
 },
 {
  "start": 556.03,
  "end": 558.29,
  "text": "برسیه کلیه کبیت مثاله اینا همه"
 },
 {
  "start": 558.29,
  "end": 560.41,
  "text": "با روش بی مود"
 },
 {
  "start": 560.41,
  "end": 562.21,
  "text": "انجام میشه روش ام مود"
 },
 {
  "start": 562.21,
  "end": 564.19,
  "text": "هم بچه ها رو همون ایکوی قلب هستش"
 },
 {
  "start": 564.19,
  "end": 566.25,
  "text": "که برای برسیه دریچه های"
 },
 {
  "start": 566.25,
  "end": 568.53,
  "text": "قلب یا موشن مود"
 },
 {
  "start": 568.53,
  "end": 570.13,
  "text": "استفاده میشه"
 },
 {
  "start": 570.13,
  "end": 572.15,
  "text": "که معمولا فرکانس هایی که تو این روش"
 },
 {
  "start": 572.15,
  "end": 574.33,
  "text": "بیم و ام استفاده می کنن در حلوش"
 },
 {
  "start": 574.33,
  "end": 576.49,
  "text": "دو نیم تا پنج میگاه"
 },
 {
  "start": 576.49,
  "end": 577.57,
  "text": "هرتس هستش"
 },
 {
  "start": 577.57,
  "end": 581.46,
  "text": "که مثلا این مقایسته کرده"
 },
 {
  "start": 581.46,
  "end": 583.62,
  "text": "ایمود با بیمود"
 },
 {
  "start": 583.62,
  "end": 585.42,
  "text": "مثلا این روش بیمود هستش"
 },
 {
  "start": 585.42,
  "end": 586.24,
  "text": "اون نقاط"
 },
 {
  "start": 586.24,
  "end": 589.56,
  "text": "خب با سابش های مختلف"
 },
 {
  "start": 589.56,
  "end": 591.2,
  "text": "تو مرز های مختلف به صورت"
 },
 {
  "start": 591.2,
  "end": 593.86,
  "text": "حالا نقاط تیره و روشن"
 },
 {
  "start": 593.86,
  "end": 595.7,
  "text": "توی شکل ای می بینید"
 },
 {
  "start": 595.7,
  "end": 597.4,
  "text": "حالا با افتای مختلف"
 },
 {
  "start": 597.4,
  "end": 599.06,
  "text": "اینجا توی شکل بی نقاط"
 },
 {
  "start": 599.06,
  "end": 601.4,
  "text": "روشن و تاریکی"
 },
 {
  "start": 601.4,
  "end": 603.1,
  "text": "مشخص کرده که"
 },
 {
  "start": 603.1,
  "end": 606.44,
  "text": "به این صورت صحب میشه ولی روش تو سی همون چی هستش"
 },
 {
  "start": 606.44,
  "end": 610.26,
  "text": "به صورت حالا اون دامنه این امواج مشخص میشه"
 },
 {
  "start": 610.26,
  "end": 614.9,
  "text": "که تو این تصویر سی اون تصویر ای مود هستش"
 },
 {
  "start": 614.9,
  "end": 624.84,
  "text": "ولی تصویر بی حالا اون برایتنس مود یا بی مود"
 },
 {
  "start": 624.84,
  "end": 632.26,
  "text": "خواسته تو اون تصویر مقایسته میکنه روش ای و روش بی"
 },
 {
  "start": 632.26,
  "end": 638.14,
  "text": "مثلا فرض و فرمایید ما تو روش این جو هم میبینید"
 },
 {
  "start": 638.14,
  "end": 645.02,
  "text": "که تو روش ایمود این دامنه امواج هستش تو بروش بیمود اون نقاط ها هستش که هرچی اون دامنه بیشتر"
 },
 {
  "start": 645.02,
  "end": 653.5,
  "text": "نقاط تیره تر میبینیم سیگنال مثلا اینجا زیفتر بوده اینجا روشنتره نسبت به این"
 },
 {
  "start": 653.5,
  "end": 660.18,
  "text": "و در نهایت تصویر ایمود به این صورتی که قبلا گفتن"
 },
 {
  "start": 660.18,
  "end": 669.2,
  "text": "ولی تصویر بی مود ما به این صورت هستش که حالا مشخص میشه"
 },
 {
  "start": 669.2,
  "end": 674.76,
  "text": "اون نقاط صورت نقاط روشن و تاریک که حالای تصویری به ما میده"
 },
 {
  "start": 674.76,
  "end": 685.87,
  "text": "یا ام مود که عرض کردم برای برسیه حالا اون دریچه های قلب هستش"
 },
 {
  "start": 685.87,
  "end": 688.29,
  "text": "شرکات دریچه های قلب استفاده میشه"
 },
 {
  "start": 688.29,
  "end": 701.48,
  "text": "یک بحث حتی بحث داپلر تصاویر داپلر"
 },
 {
  "start": 701.48,
  "end": 706.25,
  "text": "مود داپلر"
 },
 {
  "start": 706.25,
  "end": 717.64,
  "text": "ببینید بچه ها داپلر مود بچه ها یه خاصیتی هست به اسم اثر داپلر"
 },
 {
  "start": 717.64,
  "end": 722.94,
  "text": "در حالات عادی بچه ها ما گفتیم فرکانس تغییر نمی کنه"
 },
 {
  "start": 722.94,
  "end": 728.3,
  "text": "یعنی که فرکانس انواج ارسالی و باستابی تغییری نمی کنه"
 },
 {
  "start": 728.3,
  "end": 735.4,
  "text": "منتها جوز خاصیت ذاتی موج هستش که اول گفتیم خدمات چه"
 },
 {
  "start": 735.4,
  "end": 741.56,
  "text": "منطقه طبق خاص اثر داپلر این فریکانس ها میتونه تغییر بکنه"
 },
 {
  "start": 741.56,
  "end": 746.84,
  "text": "کیل تغییر میکنه زمانی که فرستنده یا گیرنده"
 },
 {
  "start": 746.84,
  "end": 759.07,
  "text": "یا گیرنده ی انواد حرکت حالا نزدیک شونده یا دور شونده داشته باشن"
 },
 {
  "start": 759.07,
  "end": 762.21,
  "text": "خب اگر هر دو ثابت باشن تو این اصلاح مشاهده بفرمایید"
 },
 {
  "start": 762.21,
  "end": 765.27,
  "text": "اگر هر دو ثابت باشن فریکانس تغییر نمیکنه"
 },
 {
  "start": 765.27,
  "end": 768.09,
  "text": "ولی اگر از هر دو منوه یا یکی از اونا متحرک باشه"
 },
 {
  "start": 768.09,
  "end": 769.99,
  "text": "حالا چه حرکت دور شونده نزدیک شونده"
 },
 {
  "start": 769.99,
  "end": 772.03,
  "text": "فرکانسیون تغییر بیکنه"
 },
 {
  "start": 772.03,
  "end": 774.57,
  "text": "که اگه حرکت دور شونده داشته باشند"
 },
 {
  "start": 774.57,
  "end": 776.55,
  "text": "فرکانس موج دریافتی"
 },
 {
  "start": 776.55,
  "end": 778.67,
  "text": "از ارسالی کمتر میشه"
 },
 {
  "start": 778.67,
  "end": 780.53,
  "text": "و اگه حرکت"
 },
 {
  "start": 780.53,
  "end": 781.85,
  "text": "نزدیک شونده باشه"
 },
 {
  "start": 781.85,
  "end": 784.25,
  "text": "فرکانس موج دریافتی از ارسالی"
 },
 {
  "start": 784.25,
  "end": 785.31,
  "text": "بیشتر میشه"
 },
 {
  "start": 785.31,
  "end": 787.83,
  "text": "به این پدیده بچه هم میگن اثر داپلر"
 },
 {
  "start": 787.83,
  "end": 790.07,
  "text": "و تحصیل برداری هم به همین صورت"
 },
 {
  "start": 790.07,
  "end": 792.23,
  "text": "بر اساس همین خاصیت داپلر"
 },
 {
  "start": 792.23,
  "end": 793.61,
  "text": "انجام میشه"
 },
 {
  "start": 793.61,
  "end": 799.91,
  "text": "مثلا ما مخواهیم صدای قلب جنین را بشنویم"
 },
 {
  "start": 799.91,
  "end": 804.49,
  "text": "یا وجود یا عدم وجود جریان خون را در یک رک ببینیم"
 },
 {
  "start": 804.49,
  "end": 806.59,
  "text": "چون ما انواد بچه ها می فرستیم"
 },
 {
  "start": 806.59,
  "end": 811.09,
  "text": "چون این انواد وقتی که به یک مثلا خون"
 },
 {
  "start": 811.09,
  "end": 813.75,
  "text": "یا قلب جنین که در حال حرکت هست"
 },
 {
  "start": 813.75,
  "end": 814.61,
  "text": "در حال زدن هست"
 },
 {
  "start": 814.61,
  "end": 816.69,
  "text": "ما وقتی برخورد میکنه"
 },
 {
  "start": 816.69,
  "end": 818.21,
  "text": "چون اونا حرکت میکنن"
 },
 {
  "start": 818.21,
  "end": 820.81,
  "text": "مثلا با یک انواد F1 می فرستیم"
 },
 {
  "start": 820.81,
  "end": 824.11,
  "text": "ما با فرکانس F2 دریافت میکنیم"
 },
 {
  "start": 824.11,
  "end": 826.11,
  "text": "با فرکانس F2 دریافت میکنیم"
 },
 {
  "start": 826.11,
  "end": 832.03,
  "text": "چون گفتم اون گیرنده ما در حال حرکت هستش"
 },
 {
  "start": 832.03,
  "end": 836.49,
  "text": "چون گیرنده ما در حال حرکت هستش"
 },
 {
  "start": 836.49,
  "end": 845.37,
  "text": "بنابراین ما یک اختلاف فرکانسی بچه ها اینجا ما داریم"
 },
 {
  "start": 845.37,
  "end": 847.77,
  "text": "یعنی با یک فرکانس F1 میفرستیم"
 },
 {
  "start": 847.77,
  "end": 850.07,
  "text": "افتا دریافت میکنی اختلاف فرکانسی"
 },
 {
  "start": 850.07,
  "end": 853.53,
  "text": "داریم که میتونیم"
 },
 {
  "start": 853.53,
  "end": 854.61,
  "text": "مثلا"
 },
 {
  "start": 854.61,
  "end": 857.57,
  "text": "این اختلاف فرکانسی بلنگو بهش"
 },
 {
  "start": 857.57,
  "end": 859.63,
  "text": "وز کنیم میگیم حالا این صدای"
 },
 {
  "start": 859.63,
  "end": 861.09,
  "text": "قلب جنین هستش"
 },
 {
  "start": 861.09,
  "end": 863.63,
  "text": "در این قصد صدا"
 },
 {
  "start": 863.63,
  "end": 865.51,
  "text": "صدای قلب جنین نیست ولی"
 },
 {
  "start": 865.51,
  "end": 867.51,
  "text": "اون هارمونی ها متناسب"
 },
 {
  "start": 867.51,
  "end": 869.55,
  "text": "اون فرکانس ها متناسبه با صدای قلب"
 },
 {
  "start": 869.55,
  "end": 871.19,
  "text": "جنین"
 },
 {
  "start": 871.19,
  "end": 872.63,
  "text": "یا مثلا ما"
 },
 {
  "start": 872.63,
  "end": 874.77,
  "text": "یک فرض فرمانگی"
 },
 {
  "start": 874.77,
  "end": 876.27,
  "text": "یک فرض تصادفی میاد میگن"
 },
 {
  "start": 876.27,
  "end": 882.55,
  "text": "ببینیم عروغ قلب، عروغ مثلا ساغ پاش ببینیم که چه میدونم"
 },
 {
  "start": 882.55,
  "end": 892.54,
  "text": "حالا دوچار پارگی شده یا قد شده"
 },
 {
  "start": 892.54,
  "end": 897.42,
  "text": "یا مثلا انصداد عروغ بررسیب کنند"
 },
 {
  "start": 897.42,
  "end": 901.08,
  "text": "اینا خب ما اگه سونوی دابلر بگیرند"
 },
 {
  "start": 901.08,
  "end": 904.94,
  "text": "اگه با اون فریکانسی که گرفت میفرستیم"
 },
 {
  "start": 904.94,
  "end": 906.24,
  "text": "با اون فریکانس دریافت کنیم"
 },
 {
  "start": 906.24,
  "end": 909.0,
  "text": "یعنی خون جریانه دارد"
 },
 {
  "start": 909.0,
  "end": 909.98,
  "text": "اون رگ"
 },
 {
  "start": 909.98,
  "end": 913.16,
  "text": "حالا بخاطر قطعی"
 },
 {
  "start": 913.16,
  "end": 914.72,
  "text": "رگ یا حالا موارد دیگر"
 },
 {
  "start": 914.72,
  "end": 915.68,
  "text": "ولی"
 },
 {
  "start": 915.68,
  "end": 918.9,
  "text": "حالا اگه خوب جریان داشته باشد"
 },
 {
  "start": 918.9,
  "end": 919.92,
  "text": "یعنی با این فرکانس"
 },
 {
  "start": 919.92,
  "end": 922.72,
  "text": "ما با اون فرکانسی که می فرستیم"
 },
 {
  "start": 922.72,
  "end": 923.92,
  "text": "با این فرکانسی دیگه ای"
 },
 {
  "start": 923.92,
  "end": 927.0,
  "text": "دریافت می کنیم که"
 },
 {
  "start": 927.0,
  "end": 928.32,
  "text": "حالا"
 },
 {
  "start": 928.32,
  "end": 932.76,
  "text": "می توانیم با تحجب اون اختلاف"
 },
 {
  "start": 932.76,
  "end": 934.78,
  "text": "فرکانس پی ببریم که مثلا"
 },
 {
  "start": 934.78,
  "end": 939.06,
  "text": "خونی تو این رگ"
 },
 {
  "start": 939.06,
  "end": 941.16,
  "text": "جریان داره یا حالا"
 },
 {
  "start": 941.16,
  "end": 942.32,
  "text": "جریان نداره"
 },
 {
  "start": 942.32,
  "end": 943.76,
  "text": "این روشه تشخیص دابلر"
 },
 {
  "start": 943.76,
  "end": 944.76,
  "text": "بچه ها به این صورت هست"
 },
 {
  "start": 944.76,
  "end": 947.54,
  "text": "بر اساس اختلاف"
 },
 {
  "start": 947.54,
  "end": 949.96,
  "text": "فریکانس انواج"
 },
 {
  "start": 949.96,
  "end": 952.34,
  "text": "تابشی و انواج"
 },
 {
  "start": 952.34,
  "end": 956.36,
  "text": "بازتاب شده"
 },
 {
  "start": 956.36,
  "end": 957.7,
  "text": "یا بازتابشی"
 },
 {
  "start": 957.7,
  "end": 960.8,
  "text": "یا منعکس شده"
 },
 {
  "start": 960.8,
  "end": 967.78,
  "text": "که حالا اینجا هم توضیح داده"
 },
 {
  "start": 967.78,
  "end": 969.52,
  "text": "در برسی صدای قلب جنین"
 },
 {
  "start": 969.52,
  "end": 971.62,
  "text": "ماید از انواج و فریکانس"
 },
 {
  "start": 971.62,
  "end": 973.52,
  "text": "مشخص F به سمت بیمار ارسال"
 },
 {
  "start": 973.52,
  "end": 975.72,
  "text": "میکنیم و با توجه به حرکت"
 },
 {
  "start": 975.72,
  "end": 977.16,
  "text": "قلب جنین با فرکانس مثلا"
 },
 {
  "start": 977.16,
  "end": 979.6,
  "text": "F1 دریافت میکنیم و از اختلاف"
 },
 {
  "start": 979.6,
  "end": 981.56,
  "text": "فرکانس ها صدای قلب جنین سبت میشه"
 },
 {
  "start": 981.56,
  "end": 983.74,
  "text": "که این صدا ناشیه از هارمونیکا"
 },
 {
  "start": 983.74,
  "end": 985.9,
  "text": "قلب جنین هست"
 },
 {
  "start": 985.9,
  "end": 987.64,
  "text": "یا در برسی عروغ"
 },
 {
  "start": 987.64,
  "end": 989.4,
  "text": "و جریان خون در صورتی که"
 },
 {
  "start": 989.4,
  "end": 991.72,
  "text": "مود ارسالی و دریافتی ما برابر"
 },
 {
  "start": 991.72,
  "end": 993.64,
  "text": "باشند یا جایی هیچگونه حرکت"
 },
 {
  "start": 993.64,
  "end": 995.64,
  "text": "خونی در عروغ نداریم"
 },
 {
  "start": 995.64,
  "end": 997.52,
  "text": "یا به این طریق میتونیم"
 },
 {
  "start": 997.52,
  "end": 999.92,
  "text": "سرعت گربلات خون رو به دست بیاریم"
 },
 {
  "start": 999.92,
  "end": 1001.78,
  "text": "از رابطه"
 },
 {
  "start": 1001.78,
  "end": 1003.8,
  "text": "FD که این سیستم"
 },
 {
  "start": 1003.8,
  "end": 1004.84,
  "text": "خودش رو حساب میکنه"
 },
 {
  "start": 1004.84,
  "end": 1007.44,
  "text": "FD 2FV C کسینوس تیتا"
 },
 {
  "start": 1007.44,
  "end": 1009.44,
  "text": "که تو این بچه ها"
 },
 {
  "start": 1009.44,
  "end": 1011.58,
  "text": "فرمول FD اون فریکانس دابلر"
 },
 {
  "start": 1011.58,
  "end": 1012.24,
  "text": "ما هست"
 },
 {
  "start": 1012.24,
  "end": 1015.34,
  "text": "و F اون فریکانس"
 },
 {
  "start": 1015.34,
  "end": 1016.16,
  "text": "اصلی هست"
 },
 {
  "start": 1016.16,
  "end": 1019.66,
  "text": "V سرعت اون مثلا خون یا سیال هستش"
 },
 {
  "start": 1019.66,
  "end": 1021.4,
  "text": "C هم سرعت سود"
 },
 {
  "start": 1021.4,
  "end": 1023.04,
  "text": "هستش در بافت"
 },
 {
  "start": 1023.04,
  "end": 1024.9,
  "text": "و تیم که زاویه پروپ"
 },
 {
  "start": 1024.9,
  "end": 1026.84,
  "text": "حالا شما در کسینوس تیتا"
 },
 {
  "start": 1026.84,
  "end": 1035.26,
  "text": "کلا یک در نظر بگیرید ما از این فرمول میتونیم اون درعقد شیفت داپلر رو به دست بیارید که FD میشه FV منهای FT"
 },
 {
  "start": 1035.26,
  "end": 1045.38,
  "text": "یعنی که فریکانس موجه ارسالی منهای فریکانس موجه برگشتی منهای فریکانس موجه ارسالی FD میشه"
 },
 {
  "start": 1045.38,
  "end": 1052.04,
  "text": "که ما اگه همونطور قبلا گفتم هر دور شونده باشه دریافتی کچکتر از ارسالی میشه"
 },
 {
  "start": 1052.04,
  "end": 1055.86,
  "text": "این میشه اساس بچه ها داپلر"
 },
 {
  "start": 1055.86,
  "end": 1063.24,
  "text": "و داپلکس هم یک اصلاحیست که ترکیبی از تصویر داپلکس"
 },
 {
  "start": 1063.24,
  "end": 1071.98,
  "text": "ترکیبی از بیمود هستش و داپلر"
 },
 {
  "start": 1071.98,
  "end": 1075.74,
  "text": "تصویر از بیمود و داپلر اشتران بهش میگن داپلکس"
 },
 {
  "start": 1075.74,
  "end": 1093.56,
  "text": "اثار داپلر که خدمت شما حالا توضیح دادیم"
 },
 {
  "start": 1093.56,
  "end": 1100.96,
  "text": "که حالا موقعی این سرس ما ثابت باشه خوب فریکانس تغییر نمی کنه"
 },
 {
  "start": 1100.96,
  "end": 1107.08,
  "text": "ما تا موقع حرکت بکنه چه کار میکنه خب ما میتونیم"
 },
 {
  "start": 1107.08,
  "end": 1110.4,
  "text": "حالا بسته به این کرکات دور شونده یا نزدیک شونده"
 },
 {
  "start": 1110.4,
  "end": 1116.82,
  "text": "ما میتونیم افضایش فریکانس کاهش طولی مود یا برعکس داشته باشیم"
 },
 {
  "start": 1116.82,
  "end": 1134.07,
  "text": "تو که این اثار داپرر و برای این اساس ما میریم تصاویر مختلف از در حقیقت اندامه که قابلت حرکت دارن میتونیم چی کار بکنیم به دست بیاریم"
 },
 {
  "start": 1134.07,
  "end": 1154.5,
  "text": "که حالا فرمول داپرر حالا من خدمت شما توی سلاید قبلی هم گفتم که به این صورت که دو اف وی سی کسینوس ته تا هستش"
 },
 {
  "start": 1154.5,
  "end": 1168.34,
  "text": "شفت داپلر را به دست بیاریم"
 },
 {
  "start": 1168.34,
  "end": 1172.66,
  "text": "سرعت مثلا جریان خون را به دست بیاریم"
 },
 {
  "start": 1172.66,
  "end": 1178.64,
  "text": "اینجا شما میتونید"
 },
 {
  "start": 1178.64,
  "end": 1180.24,
  "text": "وی یا"
 },
 {
  "start": 1180.24,
  "end": 1182.36,
  "text": "فریکانس ها را داشته باشید"
 },
 {
  "start": 1182.36,
  "end": 1185.46,
  "text": "شما میتونید وی یا سرعت جریان خون را به دست بیارید"
 },
 {
  "start": 1185.46,
  "end": 1189.34,
  "text": "جهت جریان خون را"
 },
 {
  "start": 1189.34,
  "end": 1190.6,
  "text": "با ترجم فریکانس های"
 },
 {
  "start": 1190.6,
  "end": 1194.26,
  "text": "فکرانو لفظایش فریکانس"
 },
 {
  "start": 1194.26,
  "end": 1196.04,
  "text": "جهت جریان خون را چه کار بکنید"
 },
 {
  "start": 1196.04,
  "end": 1197.52,
  "text": "به دست پیدا بکنید"
 },
 {
  "start": 1197.52,
  "end": 1200.0,
  "text": "که اینجا همه از خصوصیات تصویری"
 },
 {
  "start": 1200.0,
  "end": 1218.18,
  "text": "گیری داپلر هست که صور سرکت میکنه و فریکانس تغییر میکنه، شیفت داپلر میتونیم طبق فرمول که ارز کردم خدمت شما به دست بیاریم یا اون فریکانس داپلر یا شیفت داپلر."
 },
 {
  "start": 1218.18,
  "end": 1233.58,
  "text": "حالا میتونن اینو به صورت رنگی نشون بدن یا اون کالر مپ رنگ های مختلف، نه حالا تیف سری اونا رنگ ها تیف های مختلف خاک سری میتونن به دست بیارن که دون تصویر نمونه ای از حالا"
 },
 {
  "start": 1233.58,
  "end": 1238.72,
  "text": "اون انصداد و تنگی عروق را میبینید که مثلا با رنگ حالا"
 },
 {
  "start": 1238.72,
  "end": 1244.1,
  "text": "چیگه این رنگ آبی نشون داده شده"
 },
 {
  "start": 1244.1,
  "end": 1247.02,
  "text": "توی تصاویر پایینی شما میتونید ببینید"
 },
 {
  "start": 1247.02,
  "end": 1263.04,
  "text": "خیلی خوب"
 },
 {
  "start": 1263.04,
  "end": 1268.38,
  "text": "خب ممنون از سبر و حسله شما"
 },
 {
  "start": 1268.38,
  "end": 1275.8,
  "text": "مباحث حالا این فیزیک پزشکی که مربوط به من بود"
 },
 {
  "start": 1275.8,
  "end": 1279.52,
  "text": "اینجا تموم میشه و این جلسه آخر بود"
 },
 {
  "start": 1279.52,
  "end": 1286.42,
  "text": "که حالا مطالبی که من تو این جلس نیاز بود خدمت شما ارائه کردم"
 },
 {
  "start": 1286.42,
  "end": 1292.02,
  "text": "انشالله موفق و معید باشید"
 },
 {
  "start": 1292.02,
  "end": 1300.34,
  "text": "من پایان جلسات این درس را که مباحث معروض به خودم هست را اعلام میکنم"
 },
 {
  "start": 1300.34,
  "end": 1308.56,
  "text": "خیلی ممنون از توجه شما موفق و معید باشید"
 },
 {
  "start": 1308.56,
  "end": 1314.56,
  "text": "انشالله با امید دیدار و خدا نگهدار شما"
 }
]