 "elapsed_sec": 579.0,
 "language": "fa",
 "lang_prob": 1,
 "segments": [
  {
   "start": 1.68,
   "end": 37.84,
   "text": "بسم الله الرحمن الرحیم، وسلام. در ادامه مباحث ما در جلسه گذشته راجب اولتراسوند و فیزیک اولتراسوند، خصوصیات امواج اولتراسوند و اصول کلی تصفیر برداری سونوگرافی صحبت کردیم و آخرین مبحثی که بحث شد بحث تولید امواج اولتراسوند."
  },
  {
   "start": 37.86,
   "end": 43.74,
   "text": "بود که روش گفتیم بسر روش انواج اولتراسون تولید میشود"
  },
  {
   "start": 43.74,
   "end": 52.2,
   "text": "این روش سوتک گالتون که گفتیم روشی نمایشی و کاربوردی نداره"
  },
  {
   "start": 52.2,
   "end": 59.76,
   "text": "دوامین روش روش تولید انواج اولتراسون روش مگناتو استریکشن هستش"
  },
  {
   "start": 59.76,
   "end": 67.02,
   "text": "که حالا بعضی مواد فرومغناطیس مثل نیکل"
  },
  {
   "start": 67.02,
   "end": 75.76,
   "text": "اگه ما این مواد فرومغناطیس را تحت تأثیر میدان مغناطیسی"
  },
  {
   "start": 76.34,
   "end": 78.56,
   "text": "آهن روباهای قوی قرار بدیم"
  },
  {
   "start": 78.56,
   "end": 82.54,
   "text": "میتونن در حد ملکولی تغییر طول بدن"
  },
  {
   "start": 82.54,
   "end": 87.3,
   "text": "منقبض و منبسط میشن"
  },
  {
   "start": 87.3,
   "end": 90.66,
   "text": "این انقباز و انبساط های متوالی"
  },
  {
   "start": 90.66,
   "end": 95.52,
   "text": "بایست ایجاد خوب طبیعتاً ارتعاش میشه"
  },
  {
   "start": 95.52,
   "end": 100.14,
   "text": "و این ارتعاشات با فرکانس مناسبی اگه باشه"
  },
  {
   "start": 100.14,
   "end": 103.48,
   "text": "میتونه ماورا سود تولید بشه"
  },
  {
   "start": 103.48,
   "end": 107.84,
   "text": "پس بحث روش مگنلت و استرکشن بچه ها"
  },
  {
   "start": 107.84,
   "end": 112.16,
   "text": "اینه که مواد فرومغناطیس"
  },
  {
   "start": 112.16,
   "end": 116.84,
   "text": "تحت تأثیر میدان مغناطیسی"
  },
  {
   "start": 116.84,
   "end": 117.86,
   "text": "میتونن"
  },
  {
   "start": 117.86,
   "end": 121.12,
   "text": "میتونن مرتعش بشن"
  },
  {
   "start": 121.12,
   "end": 122.92,
   "text": "و اماد اولتراسون"
  },
  {
   "start": 122.92,
   "end": 125.18,
   "text": "با فرکانس مناسب تولید بکنن"
  },
  {
   "start": 125.18,
   "end": 127.22,
   "text": "که"
  },
  {
   "start": 127.22,
   "end": 132.25,
   "text": "تو این روش بچه ها"
  },
  {
   "start": 132.25,
   "end": 134.99,
   "text": "ما میتونیم تا 100 کیلو هرتز"
  },
  {
   "start": 134.99,
   "end": 136.53,
   "text": "فرکانس هایی تا 100 کیلو هرتز"
  },
  {
   "start": 136.53,
   "end": 137.89,
   "text": "تولید بکنیم اونتا چون"
  },
  {
   "start": 137.89,
   "end": 140.29,
   "text": "من قبلا نگفتم فرکانس هایی مورد"
  },
  {
   "start": 140.29,
   "end": 142.47,
   "text": "استفاده در تصویر برداری"
  },
  {
   "start": 142.47,
   "end": 144.59,
   "text": "در حد مگا هرتز"
  },
  {
   "start": 144.59,
   "end": 146.07,
   "text": "هستش لذا توی"
  },
  {
   "start": 146.07,
   "end": 148.03,
   "text": "حالا روش مگنو استریکشن"
  },
  {
   "start": 148.03,
   "end": 152.41,
   "text": "برای تصویر برداری و سونگرافی کار بردی ندارن"
  },
  {
   "start": 152.41,
   "end": 155.51,
   "text": "منطقه حالا توی فیزیوتراپی برای گرم کردن بافت ها"
  },
  {
   "start": 155.51,
   "end": 160.35,
   "text": "میتونیم در این حد فرکانس استفاده بکنیم"
  },
  {
   "start": 160.35,
   "end": 172.22,
   "text": "سوامین روش تولید انواج اولتراسون روش پیزوالکتریک هست"
  },
  {
   "start": 172.22,
   "end": 185.1,
   "text": "روش پیزوالکتریک"
  },
  {
   "start": 185.1,
   "end": 191.95,
   "text": "بعضی مواد پیزوالکتریک"
  },
  {
   "start": 191.95,
   "end": 193.73,
   "text": "یا فشار الکتریسیته"
  },
  {
   "start": 193.73,
   "end": 201.55,
   "text": "خاصیتی دارن که اگر ما اونا را تحت تأثیر میدان الکتریکی قرار بدهیم تغییر طور میدن"
  },
  {
   "start": 201.55,
   "end": 206.09,
   "text": "که اگر یک میدان الکتریکی متناوب استفاده بکنیم"
  },
  {
   "start": 206.09,
   "end": 212.17,
   "text": "بایسته حالا ایجاد انقباز و انبسات و ارتعاشات پشت سر هم میشه"
  },
  {
   "start": 212.17,
   "end": 219.75,
   "text": "که این ارتعاشات فرکانس هایی با طول موج معین تولید میکنند"
  },
  {
   "start": 219.75,
   "end": 223.49,
   "text": "مانند مثلا کوارتس، مانند تیتانات زیرکونات"
  },
  {
   "start": 223.49,
   "end": 225.59,
   "text": "روش یا پیزی تی"
  },
  {
   "start": 225.59,
   "end": 228.13,
   "text": "اینا خاصیت پیزوالکتریک دارند"
  },
  {
   "start": 228.13,
   "end": 230.79,
   "text": "و تحت تأثیر میدان الکتریکی"
  },
  {
   "start": 230.79,
   "end": 233.13,
   "text": "میتونند مرتعش بشند"
  },
  {
   "start": 233.13,
   "end": 238.63,
   "text": "و انواج با فرکانس های مختلف"
  },
  {
   "start": 238.63,
   "end": 241.23,
   "text": "از جمله اولتراسون تولید بکنند"
  },
  {
   "start": 241.23,
   "end": 245.07,
   "text": "که روش اصلی تولید انواج اولتراسون"
  },
  {
   "start": 245.07,
   "end": 248.11,
   "text": "همین روش پیزوالکتریک هست"
  },
  {
   "start": 248.11,
   "end": 252.19,
   "text": "یعنی ما تو پروپ های سونگرافی موقع تصویر سونگرافی می گیریم"
  },
  {
   "start": 252.19,
   "end": 259.03,
   "text": "با استفاده از روش پیزوالکتریک انواج ماوراستو تولید بیشه"
  },
  {
   "start": 259.03,
   "end": 270.69,
   "text": "و تشکیل تصویر هم به این روش با روش پیزوالکتریک هست که ادامه صحبت می کنیم"
  },
  {
   "start": 270.69,
   "end": 275.43,
   "text": "پیزوالکتریک بچه ها قلعا به دو روش هستش"
  },
  {
   "start": 275.43,
   "end": 280.99,
   "text": "پیزوالکتریک معکوس و پیزوالکتریک مستقیم"
  },
  {
   "start": 280.99,
   "end": 288.07,
   "text": "پیزوالکتریک معکوس به اون روشی اطلاق میشه"
  },
  {
   "start": 288.07,
   "end": 294.59,
   "text": "که اون بلور تحت تأثیر میدان الکتریکی"
  },
  {
   "start": 294.59,
   "end": 298.39,
   "text": "جریان الکتریکی برق شهر قرار میگیره"
  },
  {
   "start": 298.39,
   "end": 300.69,
   "text": "و امواج اولتراسون تولید میشه"
  },
  {
   "start": 300.69,
   "end": 304.83,
   "text": "این مرحله میگن پیزوالکتریک معکوس"
  },
  {
   "start": 304.83,
   "end": 308.27,
   "text": "که حالا توی اون پروپ های سونگرافی"
  },
  {
   "start": 308.27,
   "end": 311.03,
   "text": "ترانسدیوسر های سونگرافی اتفاق می افته"
  },
  {
   "start": 311.03,
   "end": 313.95,
   "text": "حالا راجع به خود ترانسدیوسر و پروپ"
  },
  {
   "start": 313.95,
   "end": 317.79,
   "text": "به سونگرافی توی اصلادهای بعدی صحبت می کنیم"
  },
  {
   "start": 317.79,
   "end": 321.23,
   "text": "منطبی پیزوالکتریک مستقیم"
  },
  {
   "start": 321.23,
   "end": 323.63,
   "text": "اون فرایندیه که"
  },
  {
   "start": 323.63,
   "end": 328.85,
   "text": "اون انواج اولتراسند باستا بشی از بافتها"
  },
  {
   "start": 328.85,
   "end": 331.45,
   "text": "می خورن این بلور و باعث"
  },
  {
   "start": 331.45,
   "end": 339.45,
   "text": "حالا سیگنال های الکتریکی و نهایت پالس الکتریکی و تشکیل تصویر میشه"
  },
  {
   "start": 339.45,
   "end": 342.85,
   "text": "به اون مرحله میگن پیز الکتریک مستقیم"
  },
  {
   "start": 342.85,
   "end": 350.39,
   "text": "چون میدونید شما که اساس تصویر برداری در حقیقت به رویش سونگرافی"
  },
  {
   "start": 350.39,
   "end": 359.31,
   "text": "همون بحث عواز اولتراساند تابیشی با بافتا مختلف برخورد میکنند"
  },
  {
   "start": 359.31,
   "end": 360.73,
   "text": "باستابش پیدا می کنند"
  },
  {
   "start": 360.73,
   "end": 364.25,
   "text": "و بعد از باستابش حالا دوباره به پروب برخورد می کنند"
  },
  {
   "start": 364.25,
   "end": 369.11,
   "text": "و تبدیل به پالس الکتریکی و نهایت تصویر می شند"
  },
  {
   "start": 369.11,
   "end": 373.07,
   "text": "که به این قسمت میگن پیزوالکتریک مستقیم"
  },
  {
   "start": 373.07,
   "end": 394.66,
   "text": "حالا ما روش های مختلف بلید انواج اولتراسون را گفتیم"
  },
  {
   "start": 394.66,
   "end": 400.7,
   "text": "حالا ما این انواج اولتراسون وقتی از اون پروب تولید می شود"
  },
  {
   "start": 400.7,
   "end": 403.22,
   "text": "برخورد میکنن با بدن"
  },
  {
   "start": 403.22,
   "end": 405.04,
   "text": "میخوایم ببینیم که"
  },
  {
   "start": 405.04,
   "end": 409.12,
   "text": "موقعی با بدن برخورد میکنن"
  },
  {
   "start": 409.12,
   "end": 411.64,
   "text": "طبقه چه مکانیزم هایی"
  },
  {
   "start": 411.64,
   "end": 413.26,
   "text": "چه واکنش هایی"
  },
  {
   "start": 413.26,
   "end": 416.04,
   "text": "تضعیف میشن این انواج"
  },
  {
   "start": 416.04,
   "end": 418.3,
   "text": "یعنی برهم کنش اون انواج"
  },
  {
   "start": 418.3,
   "end": 419.54,
   "text": "اولتراسون با بدن"
  },
  {
   "start": 419.54,
   "end": 421.12,
   "text": "به چه صورت هستش"
  },
  {
   "start": 421.12,
   "end": 423.02,
   "text": "که حالا"
  },
  {
   "start": 423.02,
   "end": 424.96,
   "text": "تو اصلاحی در مشاهده میفرمایید"
  },
  {
   "start": 424.96,
   "end": 426.62,
   "text": "اون ترانستیوسر فراسود"
  },
  {
   "start": 426.62,
   "end": 429.06,
   "text": "یک دست پرتوه فراسود"
  },
  {
   "start": 429.06,
   "end": 430.0,
   "text": "تولید میکنه"
  },
  {
   "start": 430.0,
   "end": 432.08,
   "text": "به سمت بدن بیمار هدایت میکنه"
  },
  {
   "start": 432.08,
   "end": 435.64,
   "text": "با عبور دست فراست و تزبافتهای مختلف"
  },
  {
   "start": 435.64,
   "end": 437.56,
   "text": "شدتش به طور کلی کم میشه"
  },
  {
   "start": 437.56,
   "end": 438.58,
   "text": "تضعیف میشه"
  },
  {
   "start": 438.58,
   "end": 441.36,
   "text": "اون واکنش هایی که"
  },
  {
   "start": 441.36,
   "end": 443.78,
   "text": "مسئول که های شدت فراست و تزب هستن"
  },
  {
   "start": 443.78,
   "end": 446.02,
   "text": "حالا یا به صورت جذب هستن"
  },
  {
   "start": 446.02,
   "end": 448.16,
   "text": "یعنی تبدیل میشن به گرما جذب میشن"
  },
  {
   "start": 448.16,
   "end": 450.1,
   "text": "یا شکست پیدا میکنن"
  },
  {
   "start": 450.1,
   "end": 451.6,
   "text": "یا پراکنده میشن"
  },
  {
   "start": 451.6,
   "end": 452.98,
   "text": "پرااش اتفاق میفته"
  },
  {
   "start": 452.98,
   "end": 455.28,
   "text": "یا ایجاد تداخل میکنن"
  },
  {
   "start": 455.28,
   "end": 459.7,
   "text": "یا باستابش یا همون منعکس بیشوند"
  },
  {
   "start": 459.7,
   "end": 462.42,
   "text": "که شما مثلا توی راژیولوژی"
  },
  {
   "start": 462.42,
   "end": 465.2,
   "text": "توی کاربورت های اکس ری تصویر برداری"
  },
  {
   "start": 465.2,
   "end": 467.42,
   "text": "ما خب بافت های مختلف"
  },
  {
   "start": 467.42,
   "end": 469.02,
   "text": "نفوس و زیری مختلف دارن"
  },
  {
   "start": 469.02,
   "end": 470.82,
   "text": "میزان جذب متفاوتی دارن"
  },
  {
   "start": 470.82,
   "end": 472.02,
   "text": "یک جا جذب زیاد"
  },
  {
   "start": 472.02,
   "end": 474.5,
   "text": "یک جا جذب کرد"
  },
  {
   "start": 474.5,
   "end": 475.64,
   "text": "یک جا تصویر سفید میشه"
  },
  {
   "start": 475.64,
   "end": 476.4,
   "text": "یک جا سیاه میشه"
  },
  {
   "start": 476.4,
   "end": 478.08,
   "text": "تشکیل تصویر میده"
  },
  {
   "start": 478.08,
   "end": 480.24,
   "text": "ولی توی سونگرافی"
  },
  {
   "start": 480.24,
   "end": 482.32,
   "text": "بچه ها اساس تصویر بر این صورت نیست"
  },
  {
   "start": 482.32,
   "end": 492.12,
   "text": "اساس تصویر بر در حقیقت اون میزان باستابش هست"
  },
  {
   "start": 492.12,
   "end": 498.54,
   "text": "یعنی آملی که باعث تشکیل تصویر در سونگرافی هست"
  },
  {
   "start": 498.54,
   "end": 502.04,
   "text": "باستابش یا همون انعکاس هستش"
  },
  {
   "start": 502.04,
   "end": 506.06,
   "text": "و وقیه موارد این کمکی به ما نمی کنه"
  },
  {
   "start": 506.06,
   "end": 511.68,
   "text": "و کلن متفاوت هست از تصاویر ایکس ری توی راژیولوشی"
  },
  {
   "start": 513.69,
   "end": 517.67,
   "text": "پس اساس و اصل تشکیل تصویر همون باستابش"
  },
  {
   "start": 517.67,
   "end": 520.77,
   "text": "هر جای ما باستابش داشته باشیم میتونیم تصویر بگیریم"
  },
  {
   "start": 520.77,
   "end": 526.81,
   "text": "حالا ببینیم که اون میزان یا درصد پرتوهای باستابی"
  },
  {
   "start": 526.81,
   "end": 531.61,
   "text": "یا باستابش به چه عواملی بستگی دارد"
  },
  {
   "start": 531.61,
   "end": 535.61,
   "text": "میزان باستابش تعد تصویر دو عامل است"
  },
  {
   "start": 535.61,
   "end": 542.61,
   "text": "یکی امپیدانس سعودی بافت و دو زاویه پرتوهای تابشی"
  },
  {
   "start": 542.61,
   "end": 551.54,
   "text": "امپیدانس سوت یا همون مقاومت سوتی که راجبون صحبت بکنیم"
  },
  {
   "start": 551.54,
   "end": 554.82,
   "text": "خب امپیدانس سوتی بچه ها"
  },
  {
   "start": 554.82,
   "end": 559.0,
   "text": "یا اکوستیک امپیدانس یا مقاومت سوتی"
  },
  {
   "start": 559.0,
   "end": 570.4,
   "text": "اون اشاره داره به اون میزان انعکاس انرژی انواج سوتی"
  },
  {
   "start": 570.4,
   "end": 574.0,
   "text": "بین اون"
  },
  {
   "start": 574.0,
   "end": 575.06,
   "text": "در اون"
  },
  {
   "start": 575.06,
   "end": 577.9,
   "text": "انترفیس ها در اون مرز های"
  },
  {
   "start": 577.9,
   "end": 580.14,
   "text": "بین دوتا بافت ها"
  },
  {
   "start": 580.14,
   "end": 582.16,
   "text": "که با زد نشون داده میشه"
  },
  {
   "start": 582.16,
   "end": 585.74,
   "text": "یعنی امپدانس صوتی"
  },
  {
   "start": 585.74,
   "end": 587.24,
   "text": "یا مقامت صوتی"
  },
  {
   "start": 587.24,
   "end": 589.16,
   "text": "بیانگره اونه که"
  },
  {
   "start": 589.16,
   "end": 590.46,
   "text": "چه میزان"
  },
  {
   "start": 590.46,
   "end": 592.04,
   "text": "امواج"
  },
  {
   "start": 592.04,
   "end": 595.2,
   "text": "اولتراسون بین دوتا بافت"
  },
  {
   "start": 595.2,
   "end": 597.16,
   "text": "در حقیقت"
  },
  {
   "start": 597.16,
   "end": 598.86,
   "text": "منعکس میشه"
  },
  {
   "start": 598.86,
   "end": 600.7,
   "text": "که با زد نشون داده میشه"
  },
  {
   "start": 600.7,
   "end": 602.5,
   "text": "و"
  },
  {
   "start": 602.5,
   "end": 609.78,
   "text": "و حاصل زرب سرعت سود در چگالی سود"
  },
  {
   "start": 609.78,
   "end": 615.2,
   "text": "یعنی زد برابر است با"
  },
  {
   "start": 615.2,
   "end": 617.76,
   "text": "وی زرب در رو"
  },
  {
   "start": 617.76,
   "end": 619.68,
   "text": "یعنی وی یا سرعت سود"
  },
  {
   "start": 619.68,
   "end": 622.24,
   "text": "در رو دانسیته یا چگالی هستش"
  },
  {
   "start": 622.24,
   "end": 624.14,
   "text": "وی سرعت سود در رو بافتاست"
  },
  {
   "start": 624.14,
   "end": 627.78,
   "text": "و رو هم اون چگالی بافتا هستش"
  },
  {
   "start": 627.78,
   "end": 628.96,
   "text": "واحدش هم بچه ها"
  },
  {
   "start": 628.96,
   "end": 631.1,
   "text": "گرم سانتیمتر مربع"
  },
  {
   "start": 631.1,
   "end": 635.34,
   "text": "زر ثانیه زر درده آنفند یا کلو گرم متر مربستانی زر درده آنفی شیش"
  },
  {
   "start": 635.34,
   "end": 637.92,
   "text": "یه واحدش میتونی میترکولی بگیم رایلیزه"
  },
  {
   "start": 637.92,
   "end": 639.92,
   "text": "به واحد رایلیزه شناخته میشه"
  },
  {
   "start": 639.92,
   "end": 642.58,
   "text": "واحد امپیدانس سعودی"
  },
  {
   "start": 642.58,
   "end": 646.65,
   "text": "یعنی ما اگر سرعت سعود در باف را"
  },
  {
   "start": 646.65,
   "end": 648.33,
   "text": "زرده چگالی اون باف کنیم"
  },
  {
   "start": 648.33,
   "end": 650.97,
   "text": "امپیدانس سعودی اون باف به دست میاد"
  },
  {
   "start": 650.97,
   "end": 653.47,
   "text": "که حالا"
  },
  {
   "start": 653.47,
   "end": 658.53,
   "text": "پس ما گفتیم یکی از پارامترهایی که تأثیر داره روی میزان باستابش"
  },
  {
   "start": 658.53,
   "end": 663.71,
   "text": "اون اختلاف امپیدانس سوتی در مرز مشترک بافتا هست"
  },
  {
   "start": 663.71,
   "end": 669.27,
   "text": "که اگه اون اختلاف سوتی در مرز مشترک"
  },
  {
   "start": 669.27,
   "end": 672.09,
   "text": "اختلاف امپیدانس در مرز مشتر بافتا یکسان باشد"
  },
  {
   "start": 672.09,
   "end": 673.99,
   "text": "یعنی دست پرتو عبور میکنه"
  },
  {
   "start": 673.99,
   "end": 675.93,
   "text": "یعنی باستابشی نخواهیم داشت"
  },
  {
   "start": 675.93,
   "end": 677.63,
   "text": "یعنی چی؟"
  },
  {
   "start": 677.63,
   "end": 680.31,
   "text": "یعنی اگر یک بافت هوموجن باشه"
  },
  {
   "start": 680.31,
   "end": 681.21,
   "text": "یکسان باشه"
  },
  {
   "start": 681.21,
   "end": 682.31,
   "text": "یک جنس باشه"
  },
  {
   "start": 682.31,
   "end": 684.03,
   "text": "چون صورت سوت در اون ثابته"
  },
  {
   "start": 684.03,
   "end": 686.19,
   "text": "امپیدانسش هم ثابت هست"
  },
  {
   "start": 686.19,
   "end": 694.84,
   "text": "پس بنابراین امپیدانس سوتی حالا یک سان توی اون بافت هست"
  },
  {
   "start": 694.84,
   "end": 698.4,
   "text": "یعنی پرتو عبور میکنن هیچ باستابشی نخواهیم داشت"
  },
  {
   "start": 698.4,
   "end": 705.72,
   "text": "چرا که میزان باستابش بر حسب درصد برابر از با زد دو منهای زد یک"
  },
  {
   "start": 705.72,
   "end": 708.9,
   "text": "زد دو به اضافه زد یک به طوان دو ضرب داره صد"
  },
  {
   "start": 708.9,
   "end": 717.98,
   "text": "که این زد یک اون امپیدانس سوتی بافت های مختلف هستن"
  },
  {
   "start": 717.98,
   "end": 721.78,
   "text": "امپیدانس سوتی بافت های مختلف هستن"
  },
  {
   "start": 721.78,
   "end": 724.16,
   "text": "زد دو امپیدانس سوتی مثلا بافت دو"
  },
  {
   "start": 724.16,
   "end": 727.14,
   "text": "امپیدانس سوتی بافت یک و همینطور"
  },
  {
   "start": 727.14,
   "end": 728.68,
   "text": "یک مثال اینجا زده"
  },
  {
   "start": 728.68,
   "end": 734.08,
   "text": "مثلا گفته درصد باستابش یک پرتوه فراسوتی"
  },
  {
   "start": 734.08,
   "end": 740.58,
   "text": "هنگام عبور از دیواره قفصه سینه یا ازوله به ریه هوا یا هوا چقدره"
  },
  {
   "start": 740.58,
   "end": 742.44,
   "text": "یعنی ما یک انوادی بفرستیم"
  },
  {
   "start": 742.44,
   "end": 744.84,
   "text": "از داخل قفصه سینه عبور میدیم"
  },
  {
   "start": 744.84,
   "end": 746.2,
   "text": "به ریه که میرسه ببینیم"
  },
  {
   "start": 746.2,
   "end": 749.6,
   "text": "اون مرز بین ریه که پره از حواست"
  },
  {
   "start": 749.6,
   "end": 751.86,
   "text": "به قفصه سینه میزان باستابه چقدره"
  },
  {
   "start": 751.86,
   "end": 753.9,
   "text": "خب درصد باستابه چقدره"
  },
  {
   "start": 753.9,
   "end": 760.1,
   "text": "خب ما زده دو که مربوط به قفصه ازوله هست"
  },
  {
   "start": 760.1,
   "end": 762.46,
   "text": "مرزان یک و هفته همه رایلزه"
  },
  {
   "start": 762.46,
   "end": 765.2,
   "text": "زده یک مربوط به حواست"
  },
  {
   "start": 765.2,
   "end": 770.46,
   "text": "چار ده هزارومه"
  },
  {
   "start": 770.46,
   "end": 771.6,
   "text": "ده هزارومه هست"
  },
  {
   "start": 771.6,
   "end": 773.98,
   "text": "خب اینو توی فرمال جایگزاری میکنیم"
  },
  {
   "start": 773.98,
   "end": 776.68,
   "text": "اون میزان در حقیقت"
  },
  {
   "start": 776.68,
   "end": 781.96,
   "text": "رفلکس یا باستابش بین این دوتا مرز"
  },
  {
   "start": 781.96,
   "end": 784.58,
   "text": "به دست میاد که تقریبا 99.5 درصد هست"
  },
  {
   "start": 784.58,
   "end": 785.46,
   "text": "بر اساس این فرمال"
  },
  {
   "start": 785.46,
   "end": 787.22,
   "text": "یعنی چی؟"
  },
  {
   "start": 787.22,
   "end": 788.98,
   "text": "یعنی وقتی ما یک"
  },
  {
   "start": 788.98,
   "end": 792.28,
   "text": "اواج اولتراسون را از مرز از ظله به ریه"
  },
  {
   "start": 792.28,
   "end": 794.56,
   "text": "می خواهیم بفرستیم مرز از اوله و ریه"
  },
  {
   "start": 794.56,
   "end": 796.68,
   "text": "صد درصد تقریبا"
  },
  {
   "start": 796.68,
   "end": 798.08,
   "text": "باستابش داریم"
  },
  {
   "start": 798.08,
   "end": 799.68,
   "text": "یعنی این اصلا نمیده انواج"
  },
  {
   "start": 799.68,
   "end": 801.36,
   "text": "به داخل ریه نفوذ بکنه"
  },
  {
   "start": 801.36,
   "end": 803.36,
   "text": "از مرز از اوله و ریه"
  },
  {
   "start": 803.36,
   "end": 805.36,
   "text": "باستابش داری برمیگرده"
  },
  {
   "start": 805.36,
   "end": 808.26,
   "text": "به همین خاطر هم ما سونگرافی ریه نداریم"
  },
  {
   "start": 808.26,
   "end": 809.78,
   "text": "نمیتونیم سونگرافی"
  },
  {
   "start": 809.78,
   "end": 811.18,
   "text": "ریه بگیریم"
  },
  {
   "start": 811.18,
   "end": 812.96,
   "text": "چون به محضی که مرز این انواج"
  },
  {
   "start": 812.96,
   "end": 814.92,
   "text": "بخواهن نفوذ کنن"
  },
  {
   "start": 814.92,
   "end": 816.18,
   "text": "تو ریه"
  },
  {
   "start": 816.18,
   "end": 818.78,
   "text": "و از اونجا تصویر بگیریم"
  },
  {
   "start": 818.78,
   "end": 820.36,
   "text": "اطلاعات رو برای ما بگیرند بیارند"
  },
  {
   "start": 820.36,
   "end": 822.52,
   "text": "ما اون رو سب بکنیم و تصویر داشته باشیم"
  },
  {
   "start": 822.52,
   "end": 824.0,
   "text": "اصلا باستابش میکنند"
  },
  {
   "start": 824.0,
   "end": 826.26,
   "text": "وقتی باستابش بکنند از اون مرزه"
  },
  {
   "start": 826.26,
   "end": 828.18,
   "text": "پس ما نمیتونیم سونگرافی"
  },
  {
   "start": 828.18,
   "end": 830.88,
   "text": "ریه داشته باشیم"
  },
  {
   "start": 830.88,
   "end": 833.13,
   "text": "خب"
  },
  {
   "start": 833.13,
   "end": 836.05,
   "text": "که این اسطلاعات هم بچه ها توضیح داده"
  },
  {
   "start": 836.05,
   "end": 837.07,
   "text": "که"
  },
  {
   "start": 837.07,
   "end": 839.17,
   "text": "میگفته که حالا توضیح"
  },
  {
   "start": 839.17,
   "end": 841.63,
   "text": "اسطلاعات و فرمال قبل هستش"
  },
  {
   "start": 841.63,
   "end": 843.03,
   "text": "که امپیدانس دوتی ریه"
  },
  {
   "start": 843.03,
   "end": 845.17,
   "text": "به اندازه ایست کم هست که"
  },
  {
   "start": 845.17,
   "end": 846.77,
   "text": "چارده هزارون بود دیگه رایلز بود"
  },
  {
   "start": 846.77,
   "end": 849.23,
   "text": "در مقابل امپیدانس سوطی بافت"
  },
  {
   "start": 849.23,
   "end": 850.39,
   "text": "که اون"
  },
  {
   "start": 850.39,
   "end": 852.33,
   "text": "یک و هفته هون بود"
  },
  {
   "start": 852.33,
   "end": 854.87,
   "text": "عملا میتونیم بگیم صرف نظر کرد"
  },
  {
   "start": 854.87,
   "end": 856.93,
   "text": "میتونیم بگیم نزدیک سفر دیگه"
  },
  {
   "start": 856.93,
   "end": 858.49,
   "text": "و باستابش را که حالا"
  },
  {
   "start": 858.49,
   "end": 860.35,
   "text": "99 ده همه درصده"
  },
  {
   "start": 860.35,
   "end": 862.45,
   "text": "حالا 100 درصد در نظر بگیریم"
  },
  {
   "start": 862.45,
   "end": 864.61,
   "text": "خب گفته که حالا واضح هست"
  },
  {
   "start": 864.61,
   "end": 866.89,
   "text": "که پس از باستاب"
  },
  {
   "start": 866.89,
   "end": 868.89,
   "text": "100 درصد موج"
  },
  {
   "start": 868.89,
   "end": 870.83,
   "text": "یا پرتوی برای نفوز"
  },
  {
   "start": 870.83,
   "end": 872.97,
   "text": "به لاحیه های عمقی تر باقی نمی ماند"
  },
  {
   "start": 872.97,
   "end": 874.49,
   "text": "و با سابش قویدی دیده می شه"
  },
  {
   "start": 874.49,
   "end": 876.99,
   "text": "اطلاعات ریه رو نمی تونیم بگیریم"
  },
  {
   "start": 876.99,
   "end": 878.51,
   "text": "و یکی از"
  },
  {
   "start": 878.51,
   "end": 880.83,
   "text": "علل به دست نیامدن"
  },
  {
   "start": 880.83,
   "end": 882.89,
   "text": "اطلاعات تشخیصی از داخل ریه"
  },
  {
   "start": 882.89,
   "end": 884.61,
   "text": "همین مسئله است"
  },
  {
   "start": 884.61,
   "end": 887.09,
   "text": "که خدمت شما گفتم"
  },
  {
   "start": 887.09,
   "end": 888.47,
   "text": "یا"
  },
  {
   "start": 888.47,
   "end": 890.39,
   "text": "همچنین ما اصلا ما نمی تونیم"
  },
  {
   "start": 890.39,
   "end": 892.87,
   "text": "صدای قلب را بدون استفاده"
  },
  {
   "start": 892.87,
   "end": 894.15,
   "text": "از گوشی بشتویم"
  },
  {
   "start": 894.15,
   "end": 896.63,
   "text": "چرا؟ چون صدای قلب خوب می خواهد"
  },
  {
   "start": 896.63,
   "end": 899.01,
   "text": "بیاد بیرون از ازوله"
  },
  {
   "start": 899.01,
   "end": 901.43,
   "text": "قلب و ازوله اون"
  },
  {
   "start": 901.43,
   "end": 903.07,
   "text": "قفص سینه میخواد بیارد بیرون"
  },
  {
   "start": 903.07,
   "end": 904.63,
   "text": "به چی برمیخوره بیرون"
  },
  {
   "start": 904.63,
   "end": 907.21,
   "text": "به هوا برمیخوره"
  },
  {
   "start": 907.21,
   "end": 908.09,
   "text": "دیگه هوای بیرون"
  },
  {
   "start": 908.09,
   "end": 910.53,
   "text": "چون اختلاف امپدانس اون ازوله"
  },
  {
   "start": 910.53,
   "end": 913.05,
   "text": "و هوای بیرون زیاد هست"
  },
  {
   "start": 913.05,
   "end": 914.63,
   "text": "خب باستابش تقریبا"
  },
  {
   "start": 914.63,
   "end": 916.09,
   "text": "صد درصدی داریم"
  },
  {
   "start": 916.09,
   "end": 918.51,
   "text": "شما میگهد با استفاده از گوشی پیزشی"
  },
  {
   "start": 918.51,
   "end": 919.33,
   "text": "این کار رو میکنوید"
  },
  {
   "start": 919.33,
   "end": 921.03,
   "text": "اون هوا رو از بین میبرید"
  },
  {
   "start": 921.03,
   "end": 922.07,
   "text": "گوشی رو میذارید"
  },
  {
   "start": 922.07,
   "end": 923.73,
   "text": "و اون صدا رو"
  },
  {
   "start": 923.73,
   "end": 925.81,
   "text": "قلب را میشنوید"
  },
  {
   "start": 925.81,
   "end": 930.21,
   "text": "یا مثلا دیدیم که"
  },
  {
   "start": 930.21,
   "end": 931.67,
   "text": "برای این که متوجه بشن"
  },
  {
   "start": 931.67,
   "end": 934.11,
   "text": "مثلا در ایسکار راهن قطار میاد یا نه"
  },
  {
   "start": 934.11,
   "end": 935.85,
   "text": "اون فاصله را برمیدار"
  },
  {
   "start": 935.85,
   "end": 937.95,
   "text": "مثلا گوش را میذارن روی اون ریل"
  },
  {
   "start": 937.95,
   "end": 940.35,
   "text": "و حالا صدای قطار اگر بیاد"
  },
  {
   "start": 940.35,
   "end": 941.79,
   "text": "متوجه"
  },
  {
   "start": 941.79,
   "end": 944.55,
   "text": "مثلا صدای قطار میشید شما"
  },
  {
   "start": 944.55,
   "end": 949.76,
   "text": "خب اینجا هم"
  },
  {
   "start": 949.76,
   "end": 951.64,
   "text": "بچه ها اون فرمول را"
  },
  {
   "start": 951.64,
   "end": 952.78,
   "text": "مجددن بیان کرده"
  },
  {
   "start": 952.78,
   "end": 956.0,
   "text": "آر بر حسب درصد میزان باستابه شان ایک هاست"
  },
  {
   "start": 956.0,
   "end": 957.74,
   "text": "زدوی منهای زدیک"
  },
  {
   "start": 957.74,
   "end": 959.9,
   "text": "زد دویه به اضافه زد یک به طوان دو"
  },
  {
   "start": 959.9,
   "end": 960.86,
   "text": "ضرب در صد"
  },
  {
   "start": 960.86,
   "end": 963.86,
   "text": "که شما تو اصلاح قبلی یک مثالی"
  },
  {
   "start": 963.86,
   "end": 965.98,
   "text": "هم در این خصوص حل کردیم"
  },
  {
   "start": 965.98,
   "end": 971.2,
   "text": "مثلا اینجا"
  },
  {
   "start": 971.2,
   "end": 972.64,
   "text": "اون میزان باستابش"
  },
  {
   "start": 972.64,
   "end": 977.18,
   "text": "بین حضاله و حوارا بیان کرده"
  },
  {
   "start": 977.18,
   "end": 978.7,
   "text": "مثلا اگه زد حضاله"
  },
  {
   "start": 978.7,
   "end": 979.94,
   "text": "یک و هفت ده هم زد هوا"
  },
  {
   "start": 979.94,
   "end": 981.64,
   "text": "این مسالهش هم که حل کردیم"
  },
  {
   "start": 981.64,
   "end": 983.92,
   "text": "چار ده هم هزارون باشه"
  },
  {
   "start": 983.92,
   "end": 989.8,
   "text": "اگه کل اون"
  },
  {
   "start": 989.8,
   "end": 990.88,
   "text": "فرض و فرض"
  },
  {
   "start": 990.88,
   "end": 992.84,
   "text": "اون صد درصد اما جولتراسون ما"
  },
  {
   "start": 992.84,
   "end": 994.06,
   "text": "یک باشد"
  },
  {
   "start": 994.06,
   "end": 997.24,
   "text": "999 هزارمش"
  },
  {
   "start": 997.24,
   "end": 998.34,
   "text": "برگشت خورده"
  },
  {
   "start": 998.34,
   "end": 1001.52,
   "text": "یک هزارمش"
  },
  {
   "start": 1001.52,
   "end": 1003.74,
   "text": "عبور کرده"
  },
  {
   "start": 1003.74,
   "end": 1005.5,
   "text": "یا اگه به درصد تبدیلش بکنی"
  },
  {
   "start": 1005.5,
   "end": 1007.98,
   "text": "99 درصد برگشت خورده"
  },
  {
   "start": 1007.98,
   "end": 1009.76,
   "text": "و یک دخومش"
  },
  {
   "start": 1009.76,
   "end": 1012.1,
   "text": "یک دخوم درصدش"
  },
  {
   "start": 1012.1,
   "end": 1013.14,
   "text": "عبور کرده"
  },
  {
   "start": 1013.14,
   "end": 1018.58,
   "text": "یا بحث ترانسمیشن"
  },
  {
   "start": 1018.58,
   "end": 1019.6,
   "text": "و رفلیکشن"
  },
  {
   "start": 1019.6,
   "end": 1021.7,
   "text": "یا همون عبور و جذب اینجا"
  },
  {
   "start": 1021.7,
   "end": 1024.1,
   "text": "که به طور کلی اگه بگیم"
  },
  {
   "start": 1024.1,
   "end": 1026.42,
   "text": "فاصله بین"
  },
  {
   "start": 1026.42,
   "end": 1028.08,
   "text": "در"
  },
  {
   "start": 1028.08,
   "end": 1030.52,
   "text": "مرز بین دوتا"
  },
  {
   "start": 1030.52,
   "end": 1032.68,
   "text": "بافت بازد یک و زد دو"
  },
  {
   "start": 1032.68,
   "end": 1034.92,
   "text": "میزان اگه"
  },
  {
   "start": 1034.92,
   "end": 1036.84,
   "text": "صد درصد"
  },
  {
   "start": 1036.84,
   "end": 1039.22,
   "text": "انواز بازتابه را یک در نظر بگیریم"
  },
  {
   "start": 1039.22,
   "end": 1040.96,
   "text": "میزان اوپور که با تی"
  },
  {
   "start": 1040.96,
   "end": 1043.02,
   "text": "ترانسمیشن با تی نشون داده میشه"
  },
  {
   "start": 1043.02,
   "end": 1045.12,
   "text": "میشه برابر است با یک منهای"
  },
  {
   "start": 1045.12,
   "end": 1046.78,
   "text": "آر که آر میزانه"
  },
  {
   "start": 1046.78,
   "end": 1049.08,
   "text": "چی از بازتابهش هستش"
  },
  {
   "start": 1049.08,
   "end": 1061.84,
   "text": "مثلا اگه ایجابی"
  },
  {
   "start": 1061.84,
   "end": 1063.74,
   "text": "آر مثلا چه میدونم"
  },
  {
   "start": 1063.74,
   "end": 1067.5,
   "text": "دو دهام یعنی چی؟"
  },
  {
   "start": 1067.5,
   "end": 1072.14,
   "text": "یکی بناهی دو دهام میزان تی میشه مثلا"
  },
  {
   "start": 1072.14,
   "end": 1075.14,
   "text": "هشدهام یعنی هشتا درصد عبور کردن"
  },
  {
   "start": 1075.14,
   "end": 1079.46,
   "text": "دو درصد چی؟ بیس درصد رفلیکس شدن و حالا موارد دیگر"
  },
  {
   "start": 1079.46,
   "end": 1089.06,
   "text": "یا اینجا بین فت و کیدنی بین چربی و کلیه"
  },
  {
   "start": 1089.06,
   "end": 1092.4,
   "text": "فت با زد یک و سی و هشت"
  },
  {
   "start": 1092.4,
   "end": 1096.46,
   "text": "کیدنی با یک و شست و دو"
  },
  {
   "start": 1096.46,
   "end": 1103.1,
   "text": "که اگه مثلا کل صد درصد و یک در نظر بگیریم"
  },
  {
   "start": 1103.1,
   "end": 1105.76,
   "text": "نوصد و سی و چار هزار رومش عبور کرده"
  },
  {
   "start": 1105.76,
   "end": 1107.86,
   "text": "که اگه به درصد تبدیلش بکنیم"
  },
  {
   "start": 1107.86,
   "end": 1110.34,
   "text": "میشه نوز و سو و چار ده همه درصد عبور کرده"
  },
  {
   "start": 1110.34,
   "end": 1114.42,
   "text": "از مرز بین فت و کیدنی و شش و چار ده همش"
  },
  {
   "start": 1114.42,
   "end": 1118.34,
   "text": "برگشته منعکس شده ی رفلکت شده"
  },
  {
   "start": 1118.34,
   "end": 1121.82,
   "text": "تو بافتهای مختلف با توجه به زدهای مختلف"
  },
  {
   "start": 1121.82,
   "end": 1123.8,
   "text": "و جنسهای مختلف بافتها"
  },
  {
   "start": 1123.8,
   "end": 1129.08,
   "text": "ما میزان متفاوتی از در حقیقت با ساباش ها داریم"
  },
  {
   "start": 1129.08,
   "end": 1135.22,
   "text": "و اون نقاط سیاه و سفید سونگرافی هم که میبینیم که اساس اون تصویر را تشکیلیده"
  },
  {
   "start": 1135.22,
   "end": 1142.8,
   "text": "بر حساس همون اختلاف امپیدانس صوتی بین مرز های مختلف هستش"
  },
  {
   "start": 1142.8,
   "end": 1151.01,
   "text": "که تشکیل تصویرش هر جایی هم که یک جنس باشن"
  },
  {
   "start": 1151.01,
   "end": 1155.71,
   "text": "که اصلا ما توی هموجین ما اصلا تصویری نمیتونی داشته باشیم"
  },
  {
   "start": 1155.71,
   "end": 1156.95,
   "text": "چون با سابشی نداریم"
  },
  {
   "start": 1156.95,
   "end": 1161.29,
   "text": "و هرچی حالا خیلی یکی صد درست باستابش داریم"
  },
  {
   "start": 1161.29,
   "end": 1164.97,
   "text": "داشته باشیم که نمیتونیم تصویر اونایه بگیریم"
  },
  {
   "start": 1164.97,
   "end": 1167.93,
   "text": "پس بنابراین باید یک میزان باستابش مناسبی داشته باشیم"
  },
  {
   "start": 1167.93,
   "end": 1171.13,
   "text": "نه خیلی کم نه الیزیاد که باید بتونیم"
  },
  {
   "start": 1171.13,
   "end": 1172.85,
   "text": "اون تصویر خوبی داشته باشیم"
  },
  {
   "start": 1172.85,
   "end": 1177.93,
   "text": "با دانسیته و حالا کنتراست خوبی داشته باشیم"
  },
  {
   "start": 1177.93,
   "end": 1181.09,
   "text": "امیخاطر حالا میبینیم که اون تصاویر سونگرافی بچه ها"
  },
  {
   "start": 1181.09,
   "end": 1184.93,
   "text": "خیلی حالا تصاویر مثل تصاویر سونگرافی"
  },
  {
   "start": 1184.93,
   "end": 1188.53,
   "text": "اون کیفیت مناسب از نظر سپیشال رویشن"
  },
  {
   "start": 1188.53,
   "end": 1189.77,
   "text": "از نظر کنتراست رویشن"
  },
  {
   "start": 1189.77,
   "end": 1194.13,
   "text": "اون به صورت مانند سایر روشت های"
  },
  {
   "start": 1194.13,
   "end": 1196.07,
   "text": "سایر مدالیت های تصویر بداری مانند"
  },
  {
   "start": 1196.07,
   "end": 1199.57,
   "text": "امار آی ستی یا حتی راژیولوژی خیلی"
  }
 ]
}